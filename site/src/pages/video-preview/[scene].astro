  @keyframes previewFade {
    0%, 10% { opacity: 0; }
    18%, 100% { opacity: 1; }
  }

  @keyframes previewFadeUp {
    0%, 14% { opacity: 0; transform: translateY(18px); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewFadeUpSoft {
    0%, 14% { opacity: 0; transform: translateY(16px); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewTitle {
    0%, 14% { opacity: 0; transform: translateY(22px); }
    30%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewTitleSoft {
    0%, 14% { opacity: 0; transform: translateY(20px); }
    30%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewWipe {
    0%, 8% { clip-path: inset(0 100% 0 0); }
    18%, 100% { clip-path: inset(0 0 0 0); }
  }

  @keyframes previewLockup {
    0%, 12% { opacity: 0; transform: translateY(14px); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewLockupSoft {
    0%, 12% { opacity: 0; transform: translateY(14px); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewGrowX {
    0%, 14% { transform: scaleX(0); opacity: 0; }
    24%, 100% { transform: scaleX(1); opacity: 1; }
  }

  @keyframes previewBackdrop {
    0% {
      opacity: 0;
      transform: scale(1.028) translate3d(0px, 6px, 0);
    }
    12% {
      opacity: 1;
      transform: scale(1.036) translate3d(0px, 4px, 0);
    }
    100% {
      opacity: 1;
      transform: scale(1.084) translate3d(-3px, -2px, 0);
    }
  }

  @keyframes previewPanel {
    0%, 24% {
      opacity: 0;
      clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%);
      transform: translateX(0);
    }
    36%, 100% {
      opacity: 1;
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
  }

  @keyframes previewPortrait {
    0% {
      opacity: 0;
      transform:
        translate(calc(var(--event-portrait-shift-x, 0rem) + 8px), calc(var(--event-portrait-shift-y, 0rem) + 14px))
        scale(calc(var(--event-portrait-size, 1) * 0.95));
    }
    24% {
      opacity: 0.72;
      transform:
        translate(calc(var(--event-portrait-shift-x, 0rem) + 4px), calc(var(--event-portrait-shift-y, 0rem) + 8px))
        scale(calc(var(--event-portrait-size, 1) * 0.985));
    }
    100% {
      opacity: 1;
      transform:
        translate(calc(var(--event-portrait-shift-x, 0rem) + 1px), calc(var(--event-portrait-shift-y, 0rem) - 1px))
        scale(calc(var(--event-portrait-size, 1) * 1.018));
    }
  }

  @keyframes previewMythPlate {
    0%, 22% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
    34% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 82% 100%, 0 100%);
      transform: translateX(0);
    }
    44%, 100% {
      opacity: 0;
      clip-path: polygon(100% 0, 100% 0, 78% 100%, 78% 100%);
