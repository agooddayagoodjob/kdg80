  .anim {
    animation-duration: var(--anim-duration, var(--scene-duration));
    animation-fill-mode: both;
    animation-iteration-count: 1;
    animation-play-state: paused;
    animation-timing-function: cubic-bezier(0.19, 0.86, 0.24, 1);
    will-change: transform, opacity, clip-path;
  }

  .anim--fade {
    animation-name: previewFade;
  }

  .anim--fade-up {
    animation-name: previewFadeUp;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--title {
    animation-name: previewTitle;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--wipe {
    animation-name: previewWipe;
  }

  .anim--lockup {
    animation-name: previewLockup;
  }

  .anim--grow-x {
    animation-name: previewGrowX;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--backdrop {
    animation-name: previewBackdrop;
  }

  .anim--panel {
    animation-name: previewPanel;
  }

  .anim--portrait {
    animation-name: previewPortrait;
  }

  .anim--myth-plate {
    animation-name: previewMythPlate;
  }

  .anim--boost-lead-phase {
    animation-name: previewBoostLeadPhase;
  }

  .anim--boost-rule-phase {
    animation-name: previewBoostRulePhase;
  }

  .anim--boost-title-phase {
    animation-name: previewBoostTitlePhase;
  }

  .anim--boost-hook-phase {
    animation-name: previewBoostHookPhase;
  }

  .anim--detail-card {
    animation-name: previewDetailCard;
  }

  .anim--detail-line {
    animation-name: previewDetailLine;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--boost-meta-phase {
    animation-name: previewBoostMetaPhase;
  }

  .anim--boost-speaker-phase {
    animation-name: previewBoostSpeakerPhase;
  }

  .anim--card {
    animation-name: previewCard;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--slide-up {
    animation-name: previewSlideUp;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--domain-accent {
    animation-name: previewDomainAccent;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--qr {
    animation-name: previewQr;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--sequence-beat {
    animation-name: previewSequenceBeat;
    animation-delay: var(--anim-delay, 0ms);
  }

  @keyframes previewFade {
    0%, 10% { opacity: 0; }
    18%, 100% { opacity: 1; }
  }

  @keyframes previewFadeUp {
    0%, 14% { opacity: 0; transform: translateY(28px); }
    28%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewTitle {
    0%, 14% { opacity: 0; transform: translateY(34px) scale(0.985); }
    30%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes previewWipe {
    0%, 8% { clip-path: inset(0 100% 0 0); }
    18%, 100% { clip-path: inset(0 0 0 0); }
  }

  @keyframes previewLockup {
    0%, 12% { opacity: 0; transform: translateY(24px) scale(0.97); }
    28%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes previewGrowX {
    0%, 14% { transform: scaleX(0); opacity: 0; }
    24%, 100% { transform: scaleX(1); opacity: 1; }
  }

  @keyframes previewBackdrop {
    0%, 10% { opacity: 0; transform: scale(1.05) translateX(0); }
    22% { opacity: 1; transform: scale(1.02) translateX(0); }
    68% { opacity: 1; transform: scale(1.01) translateX(-8px); }
    100% { opacity: 1; transform: scale(1.02) translateX(-14px); }
  }

  @keyframes previewPanel {
    0%, 24% {
      opacity: 0;
      clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%);
      transform: translateX(0);
    }
    36%, 100% {
      opacity: 1;
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
  }

  @keyframes previewPortrait {
    0%, 24% {
      opacity: 0;
      transform:
        translate(calc(var(--event-portrait-shift-x, 0rem) + 20px), calc(var(--event-portrait-shift-y, 0rem) + 12px))
        scale(calc(var(--event-portrait-size, 1) * 0.92));
    }
    40% {
      opacity: 0.72;
      transform:
        translate(var(--event-portrait-shift-x, 0rem), var(--event-portrait-shift-y, 0rem))
        scale(calc(var(--event-portrait-size, 1) * 1.005));
    }
    54% {
      opacity: 1;
      transform:
        translate(var(--event-portrait-shift-x, 0rem), var(--event-portrait-shift-y, 0rem))
        scale(var(--event-portrait-size, 1));
    }
    100% {
      opacity: 1;
      transform:
        translate(var(--event-portrait-shift-x, 0rem), var(--event-portrait-shift-y, 0rem))
        scale(var(--event-portrait-size, 1));
    }
  }

  @keyframes previewMythPlate {
    0%, 30% {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
    46% {
      opacity: 1;
      clip-path: polygon(100% 0, 100% 0, 78% 100%, 78% 100%);
      transform: translateX(0);
    }
    58%, 100% {
      opacity: 0;
      clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%);
      transform: translateX(0);
    }
  }

  @keyframes previewBoostLeadPhase {
    0%, 30% { opacity: 0; transform: translateY(26px); }
    46%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewBoostRulePhase {
    0%, 34% { opacity: 0; transform: scaleX(0); }
    50%, 100% { opacity: 1; transform: scaleX(1); }
  }

  @keyframes previewBoostTitlePhase {
    0%, 32% { opacity: 0; transform: translateY(32px) scale(1.015); }
    50%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes previewBoostHookPhase {
    0%, 42% { opacity: 0; transform: translateY(24px); }
    58%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewDetailCard {
    0%, 64% { opacity: 0; transform: translateY(40px); }
    80%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewDetailLine {
    0% { opacity: 0; transform: translateY(18px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewBoostMetaPhase {
    0%, 72% { opacity: 0; transform: translateY(20px); }
    86%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewBoostSpeakerPhase {
    0%, 30% { opacity: 0; transform: translateY(20px) scale(0.985); }
    48%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes previewCard {
    0%, 16% { opacity: 0; transform: translateY(20px); }
    30%, 100% { opacity: 1; transform: translateY(0); }
