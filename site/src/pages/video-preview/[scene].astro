---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import type { VideoPreviewScene } from '../../lib/video-preview-scenes';
import { getVideoPreviewScene, getVideoPreviewScenes } from '../../lib/video-preview-scenes';

export const prerender = true;

export function getStaticPaths() {
  return getVideoPreviewScenes().map((scene) => ({
    params: { scene: scene.slug },
  }));
}

const slug = Astro.params.scene ?? '';
const scene = getVideoPreviewScene(slug);

if (!scene) {
  throw new Error(`Unknown video preview scene: ${slug}`);
}

const allScenes = getVideoPreviewScenes();
const sitePeriodLabel = '28 марта – 19 июля 2026';
const sequenceDreamsScene = getVideoPreviewScene('dreams');
const sequenceFutureScene = getVideoPreviewScene('future-city');
const sequenceCascadeScene = getVideoPreviewScene('cascade');
const sequenceSiteScene = getVideoPreviewScene('site');
const sequenceMaxScene = getVideoPreviewScene('max');

function getSceneTitle(value: VideoPreviewScene) {
  if (value.kind === 'boost') {
    return value.shortTitle;
  }

  if (value.kind === 'site') {
    return value.domain;
  }

  if (value.kind === 'qr') {
    return value.platform;
  }

  if (value.kind === 'cascade') {
    return value.routeLabel;
  }

  if (value.kind === 'sequence') {
    return value.title;
  }

  return `${value.tagline.join(' ')} ${value.period}`;
}
---

<PreviewLayout
  title={`Video Preview — ${scene.label}`}
  description="Служебная сцена для быстрой локальной отработки композиции, масштаба и motion."
>
  <main class="preview-scene-page">
    <aside class="preview-scene-page__hud">
      <a class="preview-scene-page__back" href="/video-preview/">/video-preview/</a>
      <p class="preview-scene-page__caption">СЦЕНА</p>
      <h1 class="preview-scene-page__title">{scene.label}</h1>
      <nav class="preview-scene-page__nav" aria-label="Список preview-сцен">
        {allScenes.map((entry) => (
          <a
            class:list={['preview-scene-page__nav-link', entry.slug === scene.slug && 'is-active']}
            href={`/video-preview/${entry.slug}/`}
          >
            {entry.label}
          </a>
        ))}
      </nav>
      <div class="preview-scene-page__controls">
        <button type="button" data-preview-restart>Перезапустить</button>
        <button type="button" data-preview-pause>Пауза</button>
        <button type="button" data-preview-play>Пуск</button>
      </div>
      <p class="preview-scene-page__hint">Для capture берётся только кадр `1920x1080` внутри video-stage.</p>
    </aside>

    <section class="preview-scene-page__stage">
      <div
        class={`video-scene video-scene--${scene.kind}`}
        data-video-scene
        data-capture-root
        style={`--scene-duration:${scene.durationMs}ms;`}
      >
        {scene.kind !== 'site' && (
          <div class="video-scene__brand anim anim--fade">
            <img src="/shared-assets/logo-znanie-main.svg" alt="Знание" />
          </div>
        )}

        {scene.kind === 'cold-open' && (
          <div class="cold-open">
            <div class="cold-open__left"></div>
            <div class="cold-open__right anim anim--wipe"></div>
            <div class="cold-open__lockup-shell anim anim--lockup">
              <img class="cold-open__lockup" src="/shared-assets/logo-80-istorii-hero.svg" alt="80 историй о главном" />
            </div>
            <div class="cold-open__copy">
              <p class="cold-open__support anim anim--fade-up">{scene.supportLine}</p>
              {scene.tagline.map((line, index) => (
                <p
                  class="cold-open__tagline-line anim anim--title"
                  style={`--anim-delay:${120 + index * 140}ms;`}
                >
                  {line}
                </p>
              ))}
            </div>
            <div class="cold-open__accent anim anim--grow-x" style="--anim-delay:260ms;"></div>
            <p class="cold-open__period anim anim--fade-up" style="--anim-delay:520ms;">{scene.period}</p>
          </div>
        )}

        {scene.kind === 'boost' && (
          <div class:list={['boost-scene', !scene.portraitImage && 'boost-scene--no-portrait']}>
            <div class="boost-scene__photo-shell">
              {scene.posterImage && <img class="boost-scene__photo anim anim--backdrop" src={scene.posterImage} alt="" />}
              <div class="boost-scene__photo-veil"></div>
            </div>
            {scene.mythText && (
              <div class="boost-scene__myth-plate anim anim--myth-plate">
                <p class="boost-scene__myth-label">{scene.mythLabel}</p>
                <p class="boost-scene__myth-text">{scene.mythText}</p>
              </div>
            )}
            <div class="boost-scene__panel anim anim--panel"></div>
            <div class="boost-scene__copy">
              <p class="boost-scene__eyebrow anim anim--boost-lead-phase">ОБ ЭТОМ ВЫ УЗНАЕТЕ НА ЛЕКЦИИ</p>
              <div class="boost-scene__rule anim anim--boost-rule-phase"></div>
              <h2 class="boost-scene__title anim anim--boost-title-phase">{scene.shortTitle}</h2>
              <p class="boost-scene__hook anim anim--boost-hook-phase">{scene.hook}</p>
              <div class="boost-scene__detail anim anim--detail-card">
                <p class="boost-scene__detail-label">{scene.detailLabel}</p>
                <div class="boost-scene__detail-lines">
                  {scene.detailLines.map((line, index) => (
                    <p class="boost-scene__detail-line anim anim--detail-line" style={`--anim-delay:${3660 + index * 160}ms; --anim-duration:420ms;`}>
                      {line}
                    </p>
                  ))}
                </div>
                {scene.detailAttribution && (
                  <p class="boost-scene__detail-attribution anim anim--detail-line" style="--anim-delay:4020ms; --anim-duration:420ms;">
                    {scene.detailAttribution}
                  </p>
                )}
              </div>
              {(scene.availabilityLabel || scene.accessLabel) && (
                <div class="boost-scene__status-row anim anim--boost-meta-phase">
                  {scene.availabilityLabel && (
                    <p class:list={[
                      'boost-scene__availability',
                      scene.availabilityTone && `boost-scene__availability--${scene.availabilityTone}`,
                    ]}>
                      {scene.availabilityLabel}
                    </p>
                  )}
                  {scene.accessLabel && <p class="boost-scene__access-pill">{scene.accessLabel}</p>}
                </div>
              )}
              <p class="boost-scene__meta anim anim--boost-meta-phase">
                {scene.dateLabel} · {scene.venue}
              </p>
            </div>
            {scene.portraitImage && (
              <img
                class="boost-scene__portrait anim anim--portrait"
                style={scene.portraitStyle}
                src={scene.portraitImage}
                alt={scene.speakerName}
              />
            )}
            <div class:list={['boost-scene__speaker-tag', !scene.portraitImage && 'boost-scene__speaker-tag--text-only', 'anim', 'anim--boost-speaker-phase']}>
              <strong>{scene.speakerName}</strong>
              <span>{scene.speakerRole}</span>
            </div>
          </div>
        )}

        {scene.kind === 'cascade' && (
          <div class="cascade-scene">
            <p class="cascade-scene__eyebrow anim anim--fade-up">ВЫБРАТЬ СВОЙ МАРШРУТ</p>
            <h2 class="cascade-scene__title anim anim--title" style="--anim-delay:110ms;">{scene.routeLabel}</h2>
            <div class="cascade-scene__grid">
              {scene.cards.map((card, index) => (
                <article class="cascade-card anim anim--card" style={`--anim-delay:${190 + index * 110}ms;`}>
                  <p class="cascade-card__date">{card.date}</p>
                  <h3>{card.title}</h3>
                </article>
              ))}
            </div>
          </div>
        )}

        {scene.kind === 'sequence' &&
          sequenceDreamsScene?.kind === 'boost' &&
          sequenceFutureScene?.kind === 'boost' &&
          sequenceCascadeScene?.kind === 'cascade' &&
          sequenceSiteScene?.kind === 'site' &&
          sequenceMaxScene?.kind === 'qr' && (
            <div class="sequence-scene">
              <section
                class="sequence-beat sequence-beat--stats anim anim--sequence-beat"
                style="--anim-delay:0ms; --anim-duration:2600ms; --seq-enter-y:28px; --seq-exit-y:-22px; --seq-enter-scale:0.975; --seq-exit-scale:1.018;"
              >
                <div class="sequence-stats">
                  <p class="sequence-stats__eyebrow">80 ИСТОРИЙ О ГЛАВНОМ</p>
                  <h2>50+ СОБЫТИЙ</h2>
                  <p>43 СПИКЕРА</p>
                  <p>ВСЕ БЕСПЛАТНО</p>
                </div>
              </section>

              <section
                class="sequence-beat sequence-beat--event anim anim--sequence-beat"
                style="--anim-delay:1600ms; --anim-duration:3700ms; --seq-enter-x:52px; --seq-exit-x:-58px; --seq-enter-scale:0.99; --seq-exit-scale:1.02;"
              >
                <img class="sequence-beat__photo" src={sequenceDreamsScene.posterImage} alt="" />
                <div class="sequence-beat__veil"></div>
                <div class="sequence-beat__panel"></div>
                <div class="sequence-beat__copy">
                  <p class="sequence-beat__eyebrow">{sequenceDreamsScene.eyebrow}</p>
                  <h2>{sequenceDreamsScene.shortTitle}</h2>
                  <p class="sequence-beat__hook">{sequenceDreamsScene.hook}</p>
                  <p class="sequence-beat__detail">{sequenceDreamsScene.detailLines[0]}</p>
                </div>
                {sequenceDreamsScene.portraitImage && (
                  <img
                    class="sequence-beat__portrait"
                    src={sequenceDreamsScene.portraitImage}
                    style={sequenceDreamsScene.portraitStyle}
                    alt={sequenceDreamsScene.speakerName}
                  />
                )}
              </section>

              <section
                class="sequence-beat sequence-beat--event anim anim--sequence-beat"
                style="--anim-delay:4700ms; --anim-duration:3400ms; --seq-enter-y:46px; --seq-exit-y:-34px; --seq-enter-scale:0.968; --seq-exit-scale:1.014;"
              >
                <img class="sequence-beat__photo" src={sequenceFutureScene.posterImage} alt="" />
                <div class="sequence-beat__veil"></div>
                <div class="sequence-beat__panel"></div>
                <div class="sequence-beat__copy">
                  <p class="sequence-beat__eyebrow">{sequenceFutureScene.eyebrow}</p>
                  <h2>{sequenceFutureScene.shortTitle}</h2>
                  <p class="sequence-beat__hook">{sequenceFutureScene.hook}</p>
                  <p class="sequence-beat__detail">{sequenceFutureScene.detailLines[0]}</p>
                </div>
                {sequenceFutureScene.portraitImage && (
                  <img
                    class="sequence-beat__portrait"
                    src={sequenceFutureScene.portraitImage}
                    style={sequenceFutureScene.portraitStyle}
                    alt={sequenceFutureScene.speakerName}
                  />
                )}
              </section>

              <section
                class="sequence-beat sequence-beat--route anim anim--sequence-beat"
                style="--anim-delay:7700ms; --anim-duration:3200ms; --seq-enter-x:-44px; --seq-exit-x:38px; --seq-enter-scale:0.985; --seq-exit-scale:1.012;"
              >
                <div class="sequence-route">
                  <p class="sequence-route__eyebrow">МАРШРУТ ПО ФЕСТИВАЛЮ</p>
                  <h2>ЛЕКЦИИ · ДИАЛОГИ · ВЫСТАВКИ</h2>
                  <div class="sequence-route__grid">
                    {sequenceCascadeScene.cards.map((card) => (
                      <article class="sequence-route__card">
                        <p>{card.date}</p>
                        <h3>{card.title}</h3>
                      </article>
                    ))}
                  </div>
                </div>
              </section>

              <section
                class="sequence-beat sequence-beat--site anim anim--sequence-beat"
                style="--anim-delay:10300ms; --anim-duration:2500ms; --seq-enter-y:34px; --seq-exit-y:-18px; --seq-enter-scale:0.982; --seq-exit-scale:1.01;"
              >
                <div class="sequence-site">
                  <div class="sequence-site__domain-row">
                    <span class="sequence-site__domain sequence-site__domain--muted">KGD</span>
                    <span class="sequence-site__domain sequence-site__domain--accent">80</span>
                    <span class="sequence-site__domain sequence-site__domain--muted">.RU</span>
                  </div>
                  <div class="sequence-site__copy">
                    <p class="sequence-site__title">ИСТОРИЙ<br />О ГЛАВНОМ</p>
                    <p class="sequence-site__period">{sitePeriodLabel}</p>
                    <p class="sequence-site__subtitle">{sequenceSiteScene.subtitle}</p>
                  </div>
                </div>
              </section>

              <section
                class="sequence-beat sequence-beat--qr anim anim--sequence-beat"
                style="--anim-delay:12300ms; --anim-duration:3700ms; --seq-enter-x:42px; --seq-exit-x:-26px; --seq-enter-scale:0.988; --seq-exit-scale:1.008;"
              >
                <div class="sequence-qr">
                  <div class="sequence-qr__copy">
                    <p class="sequence-qr__eyebrow">{sequenceMaxScene.platform}</p>
                    <h2>{sequenceMaxScene.title}</h2>
                    <p>{sequenceMaxScene.secondary}</p>
                    <span>{sequenceMaxScene.subtitle}</span>
                  </div>
                  <div class="sequence-qr__code">
                    <img src={sequenceMaxScene.qrPath} alt={`${sequenceMaxScene.platform} QR`} />
                  </div>
                </div>
              </section>
            </div>
          )}

        {scene.kind === 'site' && (
          <div class="site-scene">
            <div class="site-scene__brand anim anim--fade">
              <img src="/shared-assets/logo-znanie-main.svg" alt="Знание" />
            </div>
            <div class="site-scene__domain-row">
              <span class="site-scene__domain site-scene__domain--muted anim anim--slide-up">KGD</span>
              <span class="site-scene__domain site-scene__domain--accent anim anim--domain-accent" style="--anim-delay:120ms;">
                80
              </span>
              <span class="site-scene__domain site-scene__domain--muted anim anim--slide-up" style="--anim-delay:220ms;">
                .RU
              </span>
            </div>
            <div class="site-scene__copy">
              <p class="site-scene__title anim anim--fade-up" style="--anim-delay:280ms;">
                ИСТОРИЙ
                <br />
                О ГЛАВНОМ
              </p>
              <p class="site-scene__period anim anim--fade-up" style="--anim-delay:380ms;">{sitePeriodLabel}</p>
              <p class="site-scene__subtitle anim anim--fade-up" style="--anim-delay:470ms;">{scene.subtitle}</p>
            </div>
          </div>
        )}

        {scene.kind === 'qr' && (
          <div class="qr-scene">
            <div class="qr-scene__copy">
              <p class="qr-scene__eyebrow anim anim--fade-up">{scene.secondary}</p>
              <h2 class="qr-scene__title anim anim--title" style="--anim-delay:120ms;">{scene.platform}</h2>
              <p class="qr-scene__channel anim anim--fade-up" style="--anim-delay:260ms;">{scene.title}</p>
              <p class="qr-scene__subtitle anim anim--fade-up" style="--anim-delay:420ms;">{scene.subtitle}</p>
            </div>
            <div class="qr-scene__code-shell anim anim--qr" style="--anim-delay:220ms;">
              <img class="qr-scene__code" src={scene.qrPath} alt={`${scene.platform} QR`} />
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ sceneTitle: getSceneTitle(scene), sceneDurationMs: scene.durationMs }}>
    const root = document.querySelector('[data-video-scene]');
    const restartButton = document.querySelector('[data-preview-restart]');
    const pauseButton = document.querySelector('[data-preview-pause]');
    const playButton = document.querySelector('[data-preview-play]');

    function getAnimations() {
      return root ? root.getAnimations({ subtree: true }) : [];
    }

    function playAnimations() {
      for (const animation of getAnimations()) {
        animation.play();
      }
    }

    function pauseAnimations() {
      for (const animation of getAnimations()) {
        animation.pause();
      }
    }

    function seekAnimations(ms = 0) {
      const animations = getAnimations();

      for (const animation of animations) {
        animation.pause();
        animation.currentTime = ms;
      }
    }

    function restartAnimations() {
      seekAnimations(0);
      requestAnimationFrame(() => {
        playAnimations();
      });
    }

    window.__videoPreview = {
      title: sceneTitle,
      durationMs: sceneDurationMs,
      play: playAnimations,
      pause: pauseAnimations,
      restart: restartAnimations,
      seek: seekAnimations,
    };

    restartButton?.addEventListener('click', restartAnimations);
    pauseButton?.addEventListener('click', pauseAnimations);
    playButton?.addEventListener('click', playAnimations);

    window.addEventListener('load', () => {
      requestAnimationFrame(() => {
        seekAnimations(0);
      });
    });
  </script>
</PreviewLayout>

<style>
  .preview-scene-page {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(18rem, 21rem) 1fr;
    gap: 1rem;
    padding: 1rem;
  }

  .preview-scene-page__hud {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(20, 16, 16, 0.76);
    backdrop-filter: blur(16px);
  }

  .preview-scene-page__back,
  .preview-scene-page__caption,
  .preview-scene-page__hint {
    color: rgba(255, 255, 255, 0.56);
  }

  .preview-scene-page__caption {
    margin: 0;
    font: 600 0.78rem/1 var(--font-display);
    letter-spacing: 0.18em;
  }

  .preview-scene-page__title {
    margin: 0;
    font: 700 clamp(1.9rem, 3vw, 2.7rem)/0.94 var(--font-display);
    color: #fff8f1;
  }

  .preview-scene-page__nav {
    display: grid;
    gap: 0.45rem;
  }

  .preview-scene-page__nav-link {
    padding: 0.72rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.03);
  }

  .preview-scene-page__nav-link.is-active {
    border-color: rgba(216, 75, 49, 0.42);
    color: white;
    background: rgba(216, 75, 49, 0.16);
  }

  .preview-scene-page__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .preview-scene-page__controls button {
    border: 0;
    padding: 0.75rem 0.95rem;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font: 500 0.92rem/1 var(--font-body);
    cursor: pointer;
  }

  .preview-scene-page__hint {
    margin: 0.2rem 0 0;
    font: 400 0.9rem/1.3 var(--font-body);
  }

  .preview-scene-page__stage {
    display: grid;
    place-items: center;
    overflow: auto;
  }

  .video-scene {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    background: #120f10;
    isolation: isolate;
  }

  .video-scene__brand {
    position: absolute;
    top: 48px;
    left: 58px;
    z-index: 10;
    width: 162px;
  }

  .cold-open,
  .boost-scene,
  .cascade-scene,
  .sequence-scene,
  .site-scene,
  .qr-scene {
    position: relative;
    width: 100%;
    height: 100%;
    transform-origin: center center;
    animation: previewScenePush var(--scene-duration) cubic-bezier(0.18, 0.8, 0.22, 1) both;
    will-change: transform;
  }

  .cold-open__left,
  .cold-open__right {
    position: absolute;
    top: 0;
    bottom: 0;
  }

  .cold-open__left {
    left: 0;
    width: 54%;
    background: #fcf8f2;
  }

  .cold-open__right {
    right: 0;
    width: 46%;
    background: #d84b31;
  }

  .cold-open__lockup-shell {
    position: absolute;
    left: 88px;
    top: 160px;
    z-index: 2;
    width: 640px;
  }

  .cold-open__copy {
    position: absolute;
    top: 246px;
    right: 88px;
    z-index: 3;
    width: 560px;
    color: white;
  }

  .cold-open__support {
    margin: 0 0 1rem;
    font: 600 1.08rem/1 var(--font-display);
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.78);
  }

  .cold-open__tagline-line {
    margin: 0;
    font: 700 6rem/0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .cold-open__accent {
    position: absolute;
    left: 88px;
    bottom: 134px;
    width: 520px;
    height: 6px;
    background: #d84b31;
    transform-origin: left center;
  }

  .cold-open__period {
    position: absolute;
    left: 88px;
    bottom: 82px;
    margin: 0;
    font: 500 2rem/1 var(--font-body);
    color: #2b2522;
  }

  .boost-scene {
    background: #130f10;
  }

  .boost-scene__myth-plate {
    position: absolute;
    inset: 0 24% 0 0;
    z-index: 8;
    display: grid;
    align-items: center;
    padding: 132px 92px 110px;
    background:
      linear-gradient(140deg, rgba(12, 10, 11, 0.96) 0%, rgba(18, 15, 16, 0.98) 62%, rgba(44, 20, 16, 0.9) 100%),
      radial-gradient(circle at 12% 22%, rgba(216, 75, 49, 0.18), transparent 26rem);
    color: white;
    pointer-events: none;
  }

  .boost-scene__myth-label {
    margin: 0 0 1.25rem;
    font: 700 1.24rem/1 var(--font-display);
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.84);
    text-transform: uppercase;
  }

  .boost-scene__myth-text {
    margin: 0;
    max-width: 12ch;
    font: 700 6.75rem/0.88 var(--font-display);
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .boost-scene__photo-shell {
    position: absolute;
    inset: 0 34% 0 0;
    overflow: hidden;
  }

  .boost-scene__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boost-scene__photo-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 12, 12, 0.18) 0%, rgba(14, 12, 12, 0.42) 48%, rgba(14, 12, 12, 0.86) 100%),
      linear-gradient(180deg, rgba(14, 12, 12, 0.14) 0%, rgba(14, 12, 12, 0.58) 100%);
  }

  .boost-scene__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: 43%;
    background:
      radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.08), transparent 24rem),
      linear-gradient(180deg, #d84b31 0%, #a82c1d 100%);
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }

  .boost-scene__copy {
    position: absolute;
    left: 72px;
    bottom: 78px;
    z-index: 4;
    width: 920px;
    color: white;
  }

  .boost-scene__eyebrow,
  .cascade-scene__eyebrow,
  .qr-scene__eyebrow {
    margin: 0;
    font: 700 1.12rem/1 var(--font-display);
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.76);
    text-transform: uppercase;
  }

  .boost-scene__rule {
    width: 220px;
    height: 6px;
    margin: 1rem 0 1.2rem;
    background: #d84b31;
    transform-origin: left center;
  }

  .boost-scene__title,
  .cascade-scene__title,
  .qr-scene__title {
    margin: 0;
    font: 700 6.2rem/0.9 var(--font-display);
    letter-spacing: -0.06em;
  }

  .boost-scene__title {
    max-width: 7ch;
    font-size: 6.6rem;
    text-wrap: balance;
