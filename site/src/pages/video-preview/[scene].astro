    letter-spacing: -0.06em;
  }

  .boost-scene__title {
    max-width: 7ch;
    text-wrap: balance;
  }

  .boost-scene__hook {
    margin: 1rem 0 0;
    max-width: 16ch;
    font: 500 2.2rem/0.98 var(--font-body);
    color: rgba(255, 255, 255, 0.88);
  }

  .boost-scene__meta {
    margin: 1.3rem 0 0;
    max-width: 42ch;
    font: 500 1.45rem/1.2 var(--font-body);
    color: rgba(255, 255, 255, 0.76);
  }

  .boost-scene__access {
    margin: 1rem 0 0;
    font: 700 1.05rem/1 var(--font-display);
    letter-spacing: 0.16em;
    color: #fff6ef;
  }

  .boost-scene__portrait {
    position: absolute;
    right: 16px;
    bottom: -6px;
    z-index: 5;
    width: min(42.5%, 35rem);
    max-height: 102%;
    object-fit: contain;
    object-position: bottom center;
    transform:
      translate(var(--event-portrait-shift-x, 0rem), var(--event-portrait-shift-y, 0rem))
      scale(var(--event-portrait-size, 1));
    transform-origin: bottom center;
  }

  .boost-scene__speaker-tag {
    position: absolute;
    left: 1210px;
    bottom: 88px;
    z-index: 6;
    width: 450px;
    color: white;
  }

  .boost-scene__speaker-tag strong {
    display: block;
    margin: 0 0 0.4rem;
    font: 700 2.15rem/0.95 var(--font-display);
    letter-spacing: -0.03em;
  }

  .boost-scene__speaker-tag span {
    display: block;
    font: 400 1.05rem/1.2 var(--font-body);
    color: rgba(255, 255, 255, 0.82);
  }

  .cascade-scene {
    padding: 170px 92px 92px;
    background:
      radial-gradient(circle at top left, rgba(216, 75, 49, 0.14), transparent 26rem),
      linear-gradient(180deg, #f5eee2 0%, #efe3d2 100%);
    color: #181513;
  }

  .cascade-scene__eyebrow {
    color: rgba(24, 21, 19, 0.56);
  }

  .cascade-scene__title {
    max-width: 10ch;
    color: #171412;
  }

  .cascade-scene__grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .cascade-card {
    min-height: 236px;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(23, 20, 18, 0.08);
    box-shadow: 0 18px 36px rgba(23, 20, 18, 0.08);
  }

  .cascade-card__date {
    margin: 0 0 0.72rem;
    font: 600 0.88rem/1 var(--font-display);
    letter-spacing: 0.16em;
    color: rgba(23, 20, 18, 0.54);
    text-transform: uppercase;
  }

  .cascade-card h3 {
    margin: 0;
    font: 700 2.15rem/0.94 var(--font-display);
    letter-spacing: -0.05em;
    color: #171412;
  }

  .site-scene {
    background: white;
    color: #1b1714;
  }

  .site-scene__brand {
    position: absolute;
    top: 54px;
    left: 64px;
    width: 172px;
  }

  .site-scene__domain-row {
    position: absolute;
    top: 240px;
    left: 50%;
    display: flex;
    align-items: flex-end;
    gap: 18px;
    transform: translateX(-50%);
  }

  .site-scene__domain {
    margin: 0;
    font: 700 8.9rem/0.84 var(--font-display);
    letter-spacing: -0.07em;
  }

  .site-scene__domain--muted {
    color: #8a8888;
  }

  .site-scene__domain--accent {
    font-size: 12.5rem;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 8px #d84b31;
    text-stroke: 8px #d84b31;
  }

  .site-scene__copy {
    position: absolute;
    top: 560px;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    transform: translateX(-50%);
    text-align: center;
  }

  .site-scene__title {
    margin: 0;
    font: 700 4.65rem/0.9 var(--font-display);
    letter-spacing: -0.05em;
    color: #1c1714;
  }

  .site-scene__period {
    margin: 0;
    font: 500 2rem/1 var(--font-body);
    color: #2c2926;
  }

  .site-scene__subtitle {
    margin: 0;
    font: 600 1.25rem/1 var(--font-display);
    letter-spacing: 0.14em;
    color: #8a8888;
  }

  .qr-scene {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    padding: 112px 88px 88px;
    background:
      radial-gradient(circle at top right, rgba(216, 75, 49, 0.08), transparent 24rem),
      linear-gradient(180deg, #fefbf6 0%, #f7f0e7 100%);
    color: #171412;
  }

  .qr-scene__copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .qr-scene__eyebrow {
    color: rgba(23, 20, 18, 0.58);
  }

  .qr-scene__title {
    margin-top: 0.7rem;
    max-width: 8ch;
    color: #151210;
  }

  .qr-scene__secondary,
  .qr-scene__subtitle {
    margin: 1rem 0 0;
    font: 500 1.6rem/1.05 var(--font-body);
    color: rgba(23, 20, 18, 0.76);
  }

  .qr-scene__subtitle {
    font: 700 1.35rem/1 var(--font-display);
    letter-spacing: 0.12em;
    color: #d84b31;
    text-transform: uppercase;
  }

  .qr-scene__code-shell {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
  }

  .qr-scene__code {
    width: 500px;
    height: 500px;
    padding: 24px;
    background: white;
    box-shadow: 0 26px 64px rgba(32, 25, 22, 0.14);
  }

  .anim {
    animation-duration: var(--scene-duration);
    animation-fill-mode: both;
    animation-iteration-count: 1;
    animation-play-state: paused;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, clip-path;
  }

  .anim--fade {
    animation-name: previewFade;
  }

  .anim--fade-up {
    animation-name: previewFadeUp;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--title {
    animation-name: previewTitle;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--wipe {
    animation-name: previewWipe;
  }

  .anim--lockup {
    animation-name: previewLockup;
  }

  .anim--grow-x {
    animation-name: previewGrowX;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--backdrop {
    animation-name: previewBackdrop;
  }

  .anim--panel {
    animation-name: previewPanel;
  }

  .anim--portrait {
    animation-name: previewPortrait;
  }

  .anim--card {
    animation-name: previewCard;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--slide-up {
    animation-name: previewSlideUp;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--domain-accent {
    animation-name: previewDomainAccent;
    animation-delay: var(--anim-delay, 0ms);
  }

  .anim--qr {
    animation-name: previewQr;
    animation-delay: var(--anim-delay, 0ms);
  }

  @keyframes previewFade {
    0%, 10% { opacity: 0; }
    18%, 100% { opacity: 1; }
  }

  @keyframes previewFadeUp {
    0%, 12% { opacity: 0; transform: translateY(32px); }
    22%, 100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes previewTitle {
    0%, 12% { opacity: 0; transform: translateY(42px) scale(0.98); }
    24%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes previewWipe {
    0%, 8% { clip-path: inset(0 100% 0 0); }
    18%, 100% { clip-path: inset(0 0 0 0); }
  }

  @keyframes previewLockup {
    0%, 10% { opacity: 0; transform: translateY(30px) scale(0.96); }
    22%, 100% { opacity: 1; transform: translateY(0) scale(1); }
