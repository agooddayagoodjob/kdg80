  .boost-scene__panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: 42%;
    background:
      radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.08), transparent 24rem),
      linear-gradient(180deg, #d84b31 0%, #a82c1d 100%);
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }

  .boost-scene__copy {
    position: absolute;
    left: 72px;
    bottom: 78px;
    z-index: 4;
    width: 860px;
    color: white;
  }

  .boost-scene__eyebrow,
  .cascade-scene__eyebrow,
  .qr-scene__eyebrow {
    margin: 0;
    font: 600 1rem/1 var(--font-display);
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.76);
    text-transform: uppercase;
  }

  .boost-scene__rule {
    width: 220px;
    height: 6px;
    margin: 1rem 0 1.2rem;
    background: #d84b31;
    transform-origin: left center;
  }

  .boost-scene__title,
  .cascade-scene__title,
  .qr-scene__title {
