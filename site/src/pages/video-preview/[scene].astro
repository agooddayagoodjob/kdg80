---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import type { VideoPreviewScene } from '../../lib/video-preview-scenes';
import { getVideoPreviewScene, getVideoPreviewScenes } from '../../lib/video-preview-scenes';

export const prerender = true;

export function getStaticPaths() {
  return getVideoPreviewScenes().map((scene) => ({
    params: { scene: scene.slug },
  }));
}

const slug = Astro.params.scene ?? '';
const scene = getVideoPreviewScene(slug);

if (!scene) {
  throw new Error(`Unknown video preview scene: ${slug}`);
}

const allScenes = getVideoPreviewScenes();
const sitePeriodLabel = '28 марта – 19 июля 2026';
const sequenceDreamsScene = getVideoPreviewScene('dreams');
const sequenceFutureScene = getVideoPreviewScene('future-city');
const sequenceCascadeScene = getVideoPreviewScene('cascade');
const sequenceSiteScene = getVideoPreviewScene('site');
const sequenceMaxScene = getVideoPreviewScene('max');
const boostMythLabelParts = scene.kind === 'boost' ? getMythLabelParts(scene.mythLabel) : { lead: '', accent: '' };
const boostDetailLineBaseDelay = scene.kind === 'boost'
  ? Math.min(3200, Math.round(scene.durationMs * 0.36))
  : 0;
const boostDetailLineStep = 110;
const boostDetailLineDuration = 420;
const boostDetailAttributionDelay = scene.kind === 'boost'
  ? Math.min(
      Math.round(scene.durationMs * 0.5),
      boostDetailLineBaseDelay + scene.detailLines.length * boostDetailLineStep + 90,
    )
  : 0;

function getSceneTitle(value: VideoPreviewScene) {
  if (value.kind === 'act-title') {
    return value.title.replace(/\n/g, ' ');
  }

  if (value.kind === 'boost') {
    return value.shortTitle;
  }

  if (value.kind === 'dialogue') {
    return value.titleLines.join(' ');
  }

  if (value.kind === 'site') {
    return value.domain;
  }

  if (value.kind === 'qr') {
    return value.platform;
  }

  if (value.kind === 'cascade') {
    return value.routeLabel;
  }

  if (value.kind === 'sequence') {
    return value.title;
  }

  return value.kind === 'cold-open'
    ? `${value.tagline.join(' ')} ${value.period}`
    : value.label;
}

function getMythWords(text?: string) {
  return text?.split(/\s+/).filter(Boolean) ?? [];
}

function getDialogueTitleWords(text: string) {
  const tokens = text.trim().split(/\s+/).filter(Boolean);
  const words: string[] = [];

  for (const token of tokens) {
    if (token === '/' && words.length) {
      words[words.length - 1] = `${words[words.length - 1]} /`;
      continue;
    }

    words.push(token);
  }

  return words;
}

function getMythLabelParts(text?: string) {
  const words = text?.trim().split(/\s+/).filter(Boolean) ?? [];
  if (!words.length) {
    return { lead: '', accent: '' };
  }

  if (words.length === 1) {
    return { lead: words[0], accent: '' };
  }

  return {
    lead: words.slice(0, -1).join(' '),
    accent: words.at(-1) ?? '',
  };
}

function getSceneBrand(value: VideoPreviewScene) {
  if (value.kind === 'dialogue') {
    if (value.variant === 'side-strip') {
      return {
        kind: 'single',
        path: '/shared-assets/logo-znanie-festival.svg',
        alt: 'Знание, 80 историй о главном',
        className: 'video-scene__brand--festival-graphite',
      };
    }

    return {
      kind: 'single',
      path: '/shared-assets/logo-znanie-festival-master-inverse.svg',
      alt: 'Знание, 80 историй о главном',
      className: 'video-scene__brand--festival-master',
    };
  }

  if (value.kind === 'boost' || value.kind === 'cascade' || value.kind === 'sequence') {
    return {
      kind: 'single',
      path: '/shared-assets/logo-znanie-festival-master-inverse.svg',
      alt: 'Знание, 80 историй о главном',
      className: 'video-scene__brand--festival-master',
    };
  }

  return {
    kind: 'single',
    path: '/shared-assets/logo-znanie-main.svg',
    alt: 'Знание',
    className: 'video-scene__brand--znanie',
  };
}

function getDialoguePlaceholderName(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return `${parts[0]} ${parts.at(-1) ?? ''}`.trim();
  }
  return name;
}

function getAnimStyle(delayMs: number, durationMs?: number) {
  const values = [`--anim-delay:${delayMs}ms`];
  if (typeof durationMs === 'number') {
    values.push(`--anim-duration:${durationMs}ms`);
  }
  return values.join('; ');
}

function getDialogueSideStripLayout(participantCount: number, titleLines: string[], subtitle: string) {
  const count = Math.max(2, Math.min(participantCount, 5));
  const columnWidth = count === 2 ? 488 : count === 3 ? 364 : count === 4 ? 260 : 236;
  const bankWidth = columnWidth * count;
  const bankLeft = 1920 - bankWidth;
  const copyLeft = 36;
  const gutter = 28;
  const copyWidth = bankLeft - copyLeft - gutter;
  const scaleFactor = count === 2 ? 0.98 : count === 3 ? 0.95 : count === 4 ? 0.92 : 0.88;
  const shiftY = count === 2 ? -12 : count === 3 ? -8 : count === 4 ? -6 : -4;
  const rosterColumns = count >= 4 ? 2 : 1;
  const titleLineCount = Math.max(titleLines.length, 1);
  const longestLineLength = titleLines.reduce((max, line) => Math.max(max, line.replace(/\s+/g, '').length), 0);
  const subtitleLength = subtitle.replace(/\s+/g, '').length;
  const titleLinePenalty = titleLineCount >= 6 ? 2.26 : titleLineCount === 5 ? 1.78 : titleLineCount === 4 ? 1.18 : titleLineCount === 3 ? 0.42 : 0;
  const titleLengthPenalty = longestLineLength >= 20 ? 1.18 : longestLineLength >= 18 ? 0.92 : longestLineLength >= 15 ? 0.54 : longestLineLength >= 12 ? 0.18 : 0;
  const titleSize = Math.max(
    3.22,
    (count === 2 ? 7.2 : count === 3 ? 6.5 : count === 4 ? 6.08 : 5.58) - titleLinePenalty - titleLengthPenalty,
  );
  const titleMax = longestLineLength >= 18
    ? 15.6
    : longestLineLength >= 14
      ? 13.4
      : longestLineLength >= 11
        ? 11.4
        : count === 2
          ? 7.4
          : count === 3
            ? 6.8
            : count === 4
              ? 6.3
              : 5.9;
  const titleGap = titleLineCount >= 6 ? 0.01 : titleLineCount === 5 ? 0.04 : titleLineCount === 4 ? 0.07 : titleLineCount === 3 ? 0.1 : 0.14;
  const subtitleSizeBase = count === 2 ? 2.08 : count === 3 ? 1.98 : count === 4 ? 1.86 : 1.74;
  const subtitleSizePenalty = subtitleLength >= 48 ? 0.22 : subtitleLength >= 34 ? 0.12 : subtitleLength >= 22 ? 0.04 : 0;
  const subtitleSize = Math.max(1.24, subtitleSizeBase - subtitleSizePenalty);
  const subtitleMax = subtitleLength >= 48 ? 22.5 : subtitleLength >= 34 ? 19.5 : subtitleLength >= 22 ? 16.5 : 13.4;
  const rosterNameSize = count === 2 ? 1.38 : count === 3 ? 1.26 : count === 4 ? 1.12 : 0.96;
  const rosterRoleSize = count === 2 ? 0.96 : count === 3 ? 0.9 : count === 4 ? 0.82 : 0.72;
  const rosterGap = count === 2 ? 0.92 : count === 3 ? 0.82 : count === 4 ? 0.72 : 0.58;
  const scheduleSize = count === 2 ? 2.18 : count === 3 ? 2.14 : count === 4 ? 2.12 : 2.18;
  const supportSize = count === 2 ? 1.02 : count === 3 ? 0.98 : count === 4 ? 0.94 : 0.88;
  const ctaSize = count === 2 ? 1.52 : count === 3 ? 1.46 : count === 4 ? 1.38 : 1.28;
  const copyTopBase = count === 5 ? 114 : count === 4 ? 120 : count === 3 ? 128 : 134;
  const copyTop = copyTopBase - (titleLineCount >= 6 ? 14 : titleLineCount === 5 ? 10 : titleLineCount === 4 ? 7 : titleLineCount === 3 ? 4 : 0);

  return {
    sceneStyle: [
      `--dialogue-side-columns:${count}`,
      `--dialogue-side-column-width:${columnWidth}px`,
      `--dialogue-side-bank-width:${bankWidth}px`,
      `--dialogue-side-bank-left:${bankLeft}px`,
      `--dialogue-side-copy-width:${copyWidth}px`,
      `--dialogue-side-copy-top:${copyTop}px`,
      `--dialogue-side-scale-factor:${scaleFactor}`,
      `--dialogue-side-shift-y:${shiftY}px`,
      `--dialogue-side-title-size:${titleSize}rem`,
      `--dialogue-side-title-max:${titleMax}ch`,
      `--dialogue-title-gap:${titleGap}rem`,
      `--dialogue-side-subtitle-size:${subtitleSize}rem`,
      `--dialogue-side-subtitle-max:${subtitleMax}ch`,
      `--dialogue-side-schedule-size:${scheduleSize}rem`,
      `--dialogue-side-support-size:${supportSize}rem`,
      `--dialogue-side-cta-size:${ctaSize}rem`,
      `--dialogue-side-roster-columns:${rosterColumns}`,
      `--dialogue-side-roster-name-size:${rosterNameSize}rem`,
      `--dialogue-side-roster-role-size:${rosterRoleSize}rem`,
      `--dialogue-side-roster-gap:${rosterGap}rem`,
    ].join('; '),
    participantsStyle: `grid-template-columns: repeat(${count}, minmax(0, ${columnWidth}px));`,
  };
}

const sceneBrand = getSceneBrand(scene);
const dialogueSideStripLayout = scene.kind === 'dialogue' && scene.variant === 'side-strip'
  ? getDialogueSideStripLayout(scene.participants.length, scene.titleLines, scene.subtitle)
  : undefined;
const dialogueAccentStyle = scene.kind === 'dialogue' && scene.variant === 'side-strip'
  ? getAnimStyle(2580, 980)
  : getAnimStyle(220, 880);
---

<PreviewLayout
  title={`Video Preview — ${scene.label}`}
  description="Служебная сцена для быстрой локальной отработки композиции, масштаба и motion."
>
  <main class="preview-scene-page">
    <aside class="preview-scene-page__hud">
      <a class="preview-scene-page__back" href="/video-preview/">/video-preview/</a>
      <p class="preview-scene-page__caption">СЦЕНА</p>
      <h1 class="preview-scene-page__title">{scene.label}</h1>
      <nav class="preview-scene-page__nav" aria-label="Список preview-сцен">
        {allScenes.map((entry) => (
          <a
            class:list={['preview-scene-page__nav-link', entry.slug === scene.slug && 'is-active']}
            href={`/video-preview/${entry.slug}/`}
          >
            {entry.label}
          </a>
        ))}
      </nav>
      <div class="preview-scene-page__controls">
        <button type="button" data-preview-restart>Перезапустить</button>
        <button type="button" data-preview-pause>Пауза</button>
        <button type="button" data-preview-play>Пуск</button>
      </div>
      <p class="preview-scene-page__hint">Для capture берётся только кадр `1920x1080` внутри video-stage.</p>
    </aside>

    <section class="preview-scene-page__stage">
      <div
        class={`video-scene video-scene--${scene.kind}`}
        data-video-scene
        data-capture-root
        style={`--scene-duration:${scene.durationMs}ms;`}
      >
        {scene.kind !== 'site' && scene.kind !== 'act-title' && (
          <div class:list={['video-scene__brand', sceneBrand.className, scene.kind !== 'dialogue' && 'anim', scene.kind !== 'dialogue' && 'anim--fade']}>
            <img src={sceneBrand.path} alt={sceneBrand.alt} />
          </div>
        )}

        {scene.kind === 'cold-open' && (
          <div class="cold-open">
            <div class="cold-open__left"></div>
            <div class="cold-open__right anim anim--wipe"></div>
            <div class="cold-open__lockup-shell anim anim--lockup">
              <img class="cold-open__lockup" src="/shared-assets/logo-80-istorii-hero.svg" alt="80 историй о главном" />
            </div>
            <div class="cold-open__copy">
              <p class="cold-open__support anim anim--fade-up">{scene.supportLine}</p>
              {scene.tagline.map((line, index) => (
                <p
                  class="cold-open__tagline-line anim anim--title"
                  style={`--anim-delay:${120 + index * 140}ms;`}
                >
                  {line}
                </p>
              ))}
            </div>
            <div class="cold-open__accent anim anim--grow-x" style="--anim-delay:260ms;"></div>
            <p class="cold-open__period anim anim--fade-up" style="--anim-delay:520ms;">{scene.period}</p>
          </div>
        )}

        {scene.kind === 'act-title' && (
          <div class="act-title-scene">
            <div class="act-title-scene__backdrop anim anim--fade"></div>
            <div class="act-title-scene__copy">
              {scene.kicker && <p class="act-title-scene__kicker anim anim--fade-up">{scene.kicker}</p>}
              <h2 class="act-title-scene__title anim anim--title" style="--anim-delay:90ms;">
                {scene.title.split('\n').map((line) => (
                  <span class="act-title-scene__title-line">{line}</span>
                ))}
              </h2>
              {scene.subtitle && (
                <p class="act-title-scene__subtitle anim anim--fade-up" style="--anim-delay:190ms;">
                  {scene.subtitle}
                </p>
              )}
            </div>
          </div>
        )}

        {scene.kind === 'boost' && (
          <div class:list={['boost-scene', !scene.portraitImage && 'boost-scene--no-portrait']}>
            <div class="boost-scene__photo-shell">
              {scene.posterImage && <img class="boost-scene__photo anim anim--backdrop" src={scene.posterImage} alt="" />}
              <div class="boost-scene__photo-veil"></div>
            </div>
            {scene.mythText && (
              <div class="boost-scene__myth-plate anim anim--myth-plate">
                <div class="boost-scene__myth-copy">
                  <p class="boost-scene__myth-label anim anim--myth-label" style="--anim-delay:120ms; --anim-duration:640ms;">
                    <span class="boost-scene__myth-label-lead">{boostMythLabelParts.lead}</span>
                    {boostMythLabelParts.accent && (
                      <>
                        {' '}
                        <span class="boost-scene__myth-label-accent">{boostMythLabelParts.accent}</span>
                      </>
                    )}
                  </p>
                  <p class="boost-scene__myth-text">
                    {getMythWords(scene.mythText).map((word, index) => (
                      <span
                        class="boost-scene__myth-word anim anim--myth-word"
                        style={`--anim-delay:${540 + index * 150}ms; --anim-duration:700ms;`}
                      >
                        {word}
                      </span>
                    ))}
                  </p>
                </div>
              </div>
            )}
            <div class="boost-scene__panel anim anim--panel"></div>
            <div class="boost-scene__copy">
              <p class="boost-scene__eyebrow anim anim--boost-lead-phase">{scene.eyebrow}</p>
              <div class="boost-scene__rule anim anim--boost-rule-phase"></div>
              <h2 class="boost-scene__title anim anim--boost-title-phase" style={scene.titleStyle}>{scene.shortTitle}</h2>
              {scene.hook && <p class="boost-scene__hook anim anim--boost-hook-phase">{scene.hook}</p>}
              {scene.detailLines.length > 0 && (
                <div class="boost-scene__detail anim anim--detail-card">
                  <p class="boost-scene__detail-label">{scene.detailLabel}</p>
                  <div class="boost-scene__detail-lines">
                    {scene.detailLines.map((line, index) => (
                      <p
                        class="boost-scene__detail-line anim anim--detail-line"
                        style={`--anim-delay:${boostDetailLineBaseDelay + index * boostDetailLineStep}ms; --anim-duration:${boostDetailLineDuration}ms;`}
                      >
                        {line}
                      </p>
                    ))}
                  </div>
                  {scene.detailAttribution && (
                    <p
                      class="boost-scene__detail-attribution anim anim--detail-line"
                      style={`--anim-delay:${boostDetailAttributionDelay}ms; --anim-duration:${boostDetailLineDuration}ms;`}
                    >
                      {scene.detailAttribution}
                    </p>
                  )}
                </div>
              )}
              {(scene.availabilityLabel || scene.accessLabel) && (
                <div class="boost-scene__status-row anim anim--boost-meta-phase">
                  {scene.availabilityLabel && (
                    <p class:list={[
                      'boost-scene__availability',
                      scene.availabilityTone && `boost-scene__availability--${scene.availabilityTone}`,
                    ]}>
                      {scene.availabilityLabel}
                    </p>
                  )}
                  {scene.accessLabel && <p class="boost-scene__access-pill">{scene.accessLabel}</p>}
                </div>
              )}
              <div class="boost-scene__meta anim anim--boost-meta-phase">
                <p class="boost-scene__schedule">{scene.dateLabel}</p>
                {scene.venue && <p class="boost-scene__venue">{scene.venue}</p>}
              </div>
            </div>
            {scene.portraitImage && (
              <img
                class="boost-scene__portrait anim anim--portrait"
                style={scene.portraitStyle}
                src={scene.portraitImage}
                alt={scene.speakerName}
              />
            )}
            <div class:list={['boost-scene__speaker-tag', !scene.portraitImage && 'boost-scene__speaker-tag--text-only', 'anim', 'anim--boost-speaker-phase']}>
              <strong>{scene.speakerName}</strong>
              <span>{scene.speakerRole}</span>
            </div>
          </div>
        )}

        {scene.kind === 'dialogue' && (
          <div
            class:list={['dialogue-scene', `dialogue-scene--${scene.variant}`]}
            style={scene.variant === 'side-strip' ? dialogueSideStripLayout?.sceneStyle : undefined}
          >
            <div class:list={['dialogue-scene__backdrop', 'anim', 'anim--dialogue-backdrop']}></div>
            <div class:list={['dialogue-scene__grain', 'anim', 'anim--dialogue-grain']} style={getAnimStyle(140, 900)}></div>
            <div class:list={['dialogue-scene__accent', 'anim', 'anim--dialogue-accent']} style={dialogueAccentStyle}></div>

            <div class="dialogue-scene__copy">
              <div class="dialogue-scene__identity">
                <p class:list={['dialogue-scene__eyebrow', 'anim', 'anim--dialogue-kicker']} style={getAnimStyle(1400, 620)}>
                  {scene.eyebrow}
                </p>
                <p class:list={['dialogue-scene__format', 'anim', 'anim--dialogue-kicker']} style={getAnimStyle(1540, 660)}>
                  ОТКРЫТЫЙ ДИАЛОГ
                </p>
              </div>
              <h2 class="dialogue-scene__title">
                {scene.titleLines.map((line, index) => {
                  const words = getDialogueTitleWords(line);
                  const previousWords = scene.titleLines
                    .slice(0, index)
                    .reduce((sum, titleLine) => sum + getDialogueTitleWords(titleLine).length, 0);

                  return (
                    <span class="dialogue-scene__title-line">
                      {words.map((word, wordIndex) => (
                        <span
                          class:list={['dialogue-scene__title-word', 'anim', 'anim--myth-word']}
                          style={getAnimStyle(1760 + (previousWords + wordIndex) * 150, 700)}
                        >
                          {word}
                        </span>
                      ))}
                    </span>
                  );
                })}
              </h2>
              {scene.variant === 'side-strip' ? (
                <>
                  <div class:list={['dialogue-scene__schedule-block', 'anim', 'anim--dialogue-schedule-phase']} style={getAnimStyle(3340, 920)}>
                    <p class="dialogue-scene__schedule">{scene.dateLabel}</p>
                    {scene.venue && <p class="dialogue-scene__venue">{scene.venue}</p>}
                  </div>
                  {scene.subtitle && (
                    <p class:list={['dialogue-scene__subtitle', 'anim', 'anim--dialogue-subtitle-phase']} style={getAnimStyle(3580, 920)}>
                      {scene.subtitle}
                    </p>
                  )}
                  <p class:list={['dialogue-scene__cta', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(3940, 760)}>
                    ПОСЛУШАЙ И ЗАДАЙ СВОЙ ВОПРОС
                  </p>
                  {scene.supportLine && (
                    <p class:list={['dialogue-scene__support', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(4120, 820)}>
                      {scene.supportLine}
                    </p>
                  )}
                  <div class:list={['dialogue-scene__meta', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(4300, 820)}>
                    {scene.availabilityLabel && (
                      <p class:list={[
                        'dialogue-scene__availability',
                        scene.availabilityTone && `dialogue-scene__availability--${scene.availabilityTone}`,
                      ]}>
                        {scene.availabilityLabel}
                      </p>
                    )}
                    {scene.accessLabel && <p class="dialogue-scene__access-pill">{scene.accessLabel}</p>}
                  </div>
                  <div class="dialogue-scene__roster-shell">
                    <p class:list={['dialogue-scene__roster-label', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(4640, 720)}>
                      УЧАСТНИКИ
                    </p>
                    <div class="dialogue-scene__roster">
                      {scene.participants.map((participant, index) => (
                        <article class:list={['dialogue-scene__roster-item', 'anim', 'anim--dialogue-roster-item']} style={getAnimStyle(4800 + index * 70, 720)}>
                          <strong>{participant.name}</strong>
                          <span>{participant.role}</span>
                        </article>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <>
                  {scene.subtitle && (
                    <p class:list={['dialogue-scene__subtitle', 'anim', 'anim--dialogue-subtitle-phase']} style={getAnimStyle(3320, 920)}>
                      {scene.subtitle}
                    </p>
                  )}
                  {scene.supportLine && (
                    <p class:list={['dialogue-scene__support', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(3520, 820)}>
                      {scene.supportLine}
                    </p>
                  )}
                  <p class:list={['dialogue-scene__cta', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(3860, 760)}>
                    ПОСЛУШАЙ И ЗАДАЙ СВОЙ ВОПРОС
                  </p>
                  <div class:list={['dialogue-scene__meta', 'anim', 'anim--dialogue-copy-phase']} style={getAnimStyle(4060, 820)}>
                    {scene.availabilityLabel && (
                      <p class:list={[
                        'dialogue-scene__availability',
                        scene.availabilityTone && `dialogue-scene__availability--${scene.availabilityTone}`,
                      ]}>
                        {scene.availabilityLabel}
                      </p>
                    )}
                    {scene.accessLabel && <p class="dialogue-scene__access-pill">{scene.accessLabel}</p>}
                  </div>
                  <div class:list={['dialogue-scene__schedule-block', 'anim', 'anim--dialogue-schedule-phase']} style={getAnimStyle(3000, 920)}>
                    <p class="dialogue-scene__schedule">{scene.dateLabel}</p>
                    <p class="dialogue-scene__venue">{scene.venue}</p>
                  </div>
                </>
              )}
            </div>

            <div
              class:list={['dialogue-scene__participants', 'anim', 'anim--dialogue-bank']}
              aria-label="Участники открытого диалога"
              style={[
                scene.variant === 'side-strip' ? dialogueSideStripLayout?.participantsStyle : undefined,
                getAnimStyle(280, 1860),
              ].filter(Boolean).join('; ')}
            >
              {scene.participants.map((participant, index) => {
                const revealIndex = scene.participants.length - 1 - index;

                return (
                  <article
                    class:list={['dialogue-person', !participant.image && 'dialogue-person--placeholder', 'anim', 'anim--dialogue-participant']}
                    style={getAnimStyle(420 + revealIndex * 220, 1480)}
                  >
                    <div class:list={['dialogue-person__media', !participant.image && 'dialogue-person__media--placeholder']}>
                      {participant.image ? (
                        <img
                          class="dialogue-person__portrait"
                          src={participant.image}
                          alt={participant.name}
                          style={participant.imageStyle}
                        />
                      ) : (
                        scene.variant === 'side-strip' ? (
                          <div class="dialogue-person__placeholder-card" aria-hidden="true">
                            <span class="dialogue-person__placeholder-label">УЧАСТНИК ДИАЛОГА</span>
                            <strong>{getDialoguePlaceholderName(participant.name)}</strong>
                          </div>
                        ) : (
                          <span class="dialogue-person__monogram" aria-hidden="true">{participant.monogram}</span>
                        )
                      )}
                    </div>
                    {scene.variant !== 'side-strip' && (
                      <div class="dialogue-person__caption">
                        <strong>{participant.name}</strong>
                        <span>{participant.role}</span>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        )}

