    border-color: rgba(216, 75, 49, 0.42);
    color: white;
    background: rgba(216, 75, 49, 0.16);
  }

  .preview-scene-page__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .preview-scene-page__controls button {
    border: 0;
    padding: 0.75rem 0.95rem;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    font: 500 0.92rem/1 var(--font-body);
    cursor: pointer;
  }

  .preview-scene-page__hint {
    margin: 0.2rem 0 0;
    font: 400 0.9rem/1.3 var(--font-body);
  }

  .preview-scene-page__stage {
    display: grid;
    place-items: center;
    overflow: auto;
  }

  .video-scene {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    background: #120f10;
