  .qr-scene {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .cold-open__left,
  .cold-open__right {
    position: absolute;
    top: 0;
    bottom: 0;
  }

  .cold-open__left {
    left: 0;
    width: 54%;
    background: #fcf8f2;
  }

  .cold-open__right {
    right: 0;
    width: 46%;
    background: #d84b31;
  }

  .cold-open__lockup-shell {
    position: absolute;
    left: 88px;
    top: 160px;
    z-index: 2;
    width: 640px;
  }

  .cold-open__copy {
    position: absolute;
    top: 246px;
    right: 88px;
    z-index: 3;
    width: 560px;
    color: white;
  }

  .cold-open__support {
    margin: 0 0 1rem;
    font: 600 1.08rem/1 var(--font-display);
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.78);
  }

  .cold-open__tagline-line {
    margin: 0;
    font: 700 6rem/0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .cold-open__accent {
    position: absolute;
    left: 88px;
    bottom: 134px;
    width: 520px;
    height: 6px;
    background: #d84b31;
    transform-origin: left center;
  }

  .cold-open__period {
    position: absolute;
    left: 88px;
    bottom: 82px;
    margin: 0;
    font: 500 2rem/1 var(--font-body);
    color: #2b2522;
  }

  .boost-scene {
    background: #130f10;
  }

  .boost-scene__photo-shell {
    position: absolute;
    inset: 0 34% 0 0;
    overflow: hidden;
  }

  .boost-scene__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .boost-scene__photo-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 12, 12, 0.14) 0%, rgba(14, 12, 12, 0.38) 48%, rgba(14, 12, 12, 0.82) 100%),
      linear-gradient(180deg, rgba(14, 12, 12, 0.08) 0%, rgba(14, 12, 12, 0.52) 100%);
