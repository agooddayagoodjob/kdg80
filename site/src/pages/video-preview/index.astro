---
import Layout from '../../layouts/Layout.astro';
import { getVideoPreviewScenes } from '../../lib/video-preview-scenes';

export const prerender = true;

const scenes = getVideoPreviewScenes();
---

<Layout title="Video Preview Scenes" description="Служебный индекс сцен для локальной отработки видеоанонса." robots="noindex, nofollow">
  <main class="video-preview-index">
    <div class="video-preview-index__inner">
      <p class="video-preview-index__eyebrow">СЛУЖЕБНЫЙ PREVIEW</p>
      <h1 class="video-preview-index__title">Сцены для быстрой отработки композиции и движения</h1>
      <ul class="video-preview-index__list">
        {scenes.map((scene) => (
          <li>
            <a href={`/video-preview/${scene.slug}/`}>
              <span>{scene.label}</span>
              <span>/video-preview/{scene.slug}/</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>

<style>
  .video-preview-index {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .video-preview-index__inner {
    width: min(100%, 52rem);
    padding: 2.4rem;
    border: 1px solid rgba(18, 17, 14, 0.08);
    border-radius: 1.8rem;
    background: rgba(252, 246, 237, 0.84);
    box-shadow: 0 22px 60px rgba(18, 15, 12, 0.08);
  }

  .video-preview-index__eyebrow {
    margin: 0 0 0.75rem;
    font: 600 0.78rem/1 var(--font-display);
    letter-spacing: 0.18em;
    color: var(--accent-deep);
  }

  .video-preview-index__title {
    margin: 0 0 1.4rem;
    font: 600 clamp(2rem, 5vw, 3.5rem)/0.94 var(--font-display);
    max-width: 12ch;
  }

  .video-preview-index__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .video-preview-index__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(18, 17, 14, 0.08);
  }

  .video-preview-index__list span:last-child {
    color: var(--ink-muted);
    font-size: 0.92rem;
  }
</style>
