---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import { getVideoPreviewScenes } from '../../lib/video-preview-scenes';

export const prerender = true;

const scenes = getVideoPreviewScenes();
---

<PreviewLayout title="Video Preview Scenes" description="Служебный индекс video-first сцен для анонсирующего ролика.">
  <main class="preview-index">
    <div class="preview-index__panel">
      <p class="preview-index__eyebrow">VIDEO-FIRST PREVIEW</p>
      <h1 class="preview-index__title">Сцены для быстрой отработки композиции, масштаба и motion</h1>
      <div class="preview-index__notes">
        <strong>Testing notes</strong>
        <a href="/video-preview/animation-testing/">/video-preview/animation-testing/</a>
        <a href="/video-preview/testing/">/video-preview/testing/</a>
      </div>
      <ul class="preview-index__list">
        {scenes.map((scene) => (
          <li>
            <a href={`/video-preview/${scene.slug}/`}>
              <strong>{scene.label}</strong>
              <span>/video-preview/{scene.slug}/</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</PreviewLayout>

<style>
  .preview-index {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .preview-index__panel {
    width: min(100%, 56rem);
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(22, 18, 18, 0.78);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px);
  }

  .preview-index__eyebrow {
    margin: 0 0 0.9rem;
    font: 600 0.82rem/1 var(--font-display);
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.62);
  }

  .preview-index__title {
    margin: 0 0 1.6rem;
    max-width: 12ch;
    font: 700 clamp(2.4rem, 5vw, 4rem)/0.94 var(--font-display);
    color: #fcf7ef;
  }

  .preview-index__list {
    margin: 0;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .preview-index__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    align-items: center;
    padding: 0.95rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
  }

  .preview-index__notes strong {
    font: 700 0.96rem/1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff8f1;
  }

  .preview-index__notes a {
    font: 500 0.96rem/1.15 var(--font-body);
    color: rgba(255, 248, 241, 0.78);
  }

  .preview-index__list a {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    transition: background 180ms ease, border-color 180ms ease;
  }

  .preview-index__list a:hover {
    background: rgba(216, 75, 49, 0.12);
    border-color: rgba(216, 75, 49, 0.34);
  }

  .preview-index__list strong {
    font: 600 1.2rem/1.05 var(--font-display);
    color: #fff8f1;
  }

  .preview-index__list span {
    font: 500 0.96rem/1.15 var(--font-body);
    color: rgba(255, 255, 255, 0.58);
  }
</style>
