---
import Layout from '../../../src/layouts/Layout.astro';

const routeTitle = 'Паспорт участника фестиваля | 80 историй о главном';
const routeDescription = 'Печатный макет A4 с двумя A5-экземплярами паспорта участника фестиваля «80 историй о главном».';
const festivalPeriod = '28 марта - 19 июля 2026';
const stampSlots = Array.from({ length: 6 }, (_, index) => ({
  index: index + 1,
  label: `Отметка ${index + 1}`,
}));
const qrItems = [
  {
    title: 'Telegram',
    caption: '@kenigevents',
    href: 'https://t.me/kenigevents',
    imageSrc: '/generated/telegram/kenigevents-qr.svg',
    imageAlt: 'QR-код Telegram-канала фестиваля',
  },
  {
    title: 'MAX',
    caption: 'Канал фестиваля',
    href: 'https://max.ru/join/do_4eLW85-yK_dXcc6f2cmKp9utJuFl_hCo0cxnJ1QA',
    imageSrc: '/generated/max/max-channel-qr.svg',
    imageAlt: 'QR-код канала фестиваля в мессенджере MAX',
  },
];
const copies = [
  { key: 'left', accessible: true },
  { key: 'right', accessible: false },
];
---

<Layout
  title={routeTitle}
  description={routeDescription}
  canonicalPath="/pasport-uchastnika/"
  robots="noindex, nofollow"
>
  <main class="passport-print" data-passport-root data-passport-tone="color">
    <section class="passport-toolbar screen-only" aria-label="Управление макетом">
      <div class="passport-toolbar__copy">
        <p class="passport-toolbar__eyebrow">Печатный макет фестиваля</p>
        <h1>Паспорт участника для A4 и A5</h1>
        <p>
          На печать выводится лист A4 в альбомной ориентации. На нём уже собраны две одинаковые A5-копии
          с центральной линией реза и безопасными полями.
        </p>
      </div>

      <div class="passport-toolbar__actions">
        <div class="passport-toolbar__group" role="group" aria-label="Режим предпросмотра">
          <button class="passport-toolbar__button is-active" type="button" data-tone-button="color">Цветной preview</button>
          <button class="passport-toolbar__button" type="button" data-tone-button="mono">Ч/б preview</button>
        </div>
        <button class="passport-toolbar__button passport-toolbar__button--primary" type="button" data-passport-print>
          Печать
        </button>
      </div>
    </section>

    <section class="passport-sheet" aria-label="Лист A4 с двумя копиями паспорта участника">
      <div class="passport-sheet__cutline" aria-hidden="true">
        <span>Линия реза</span>
      </div>

      {copies.map(({ key, accessible }) => (
        <section class={`passport-sheet__half passport-sheet__half--${key}`}>
          <article class="passport-card" aria-hidden={accessible ? undefined : 'true'}>
            <header class="passport-card__header">
              <div class="passport-card__intro-head">
                <p class="passport-card__eyebrow">Просветительский фестиваль Российского общества Знание</p>
                <p class="passport-card__kicker">К 80-летию Калининградской области</p>
              </div>

              <div class="passport-card__brand-row">
                <div class="passport-card__title-block">
                  <p class="passport-card__label">Паспорт участника фестиваля</p>
                  <h2 class="passport-card__title" id={`passport-title-${key}`}>80 историй о главном</h2>
                </div>
                <div class="passport-card__hero-mark">
                  <img
                    src="/shared-assets/logo-80-istorii-hero.svg"
                    alt="Логотип фестиваля 80 историй о главном"
                    width="431"
                    height="373"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>
            </header>

            <div class="passport-card__body">
              <div class="passport-card__main">
                <section class="passport-card__summary">
                  <p>
                    Этот паспорт отмечает посещение лекций, открытых диалогов, выставок и спецформатов фестиваля.
                    Пять штампов открывают доступ к спецсобытиям. Дату визита впишите вручную рядом с отметкой.
                  </p>
                </section>

                <section class="passport-card__identity" aria-labelledby={`passport-name-${key}`}>
                  <div class="passport-card__field-head">
                    <p class="passport-card__section-label" id={`passport-name-${key}`}>Участник</p>
                    <p class="passport-card__field-note">Фамилия, имя, отчество</p>
                  </div>
                  <div class="passport-card__field-line" aria-hidden="true"></div>
                </section>

                <section class="passport-card__stamps" aria-labelledby={`passport-stamps-${key}`}>
                  <div class="passport-card__stamps-head">
                    <div>
                      <p class="passport-card__section-label" id={`passport-stamps-${key}`}>Отметки посещения</p>
                      <p class="passport-card__stamps-note">Минимум 5 штампов для доступа к спецсобытиям</p>
                    </div>
                  </div>

                  <div class="passport-card__stamps-grid">
                    {stampSlots.map((slot) => (
                      <article class="stamp-slot">
                        <div class="stamp-slot__top">
                          <span class="stamp-slot__number">{String(slot.index).padStart(2, '0')}</span>
                          <span class="stamp-slot__label">{slot.label}</span>
                        </div>
                        <div class="stamp-slot__seal" aria-hidden="true">Штамп</div>
                        <div class="stamp-slot__date">
                          <span>Дата</span>
                          <span class="stamp-slot__date-line" aria-hidden="true"></span>
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              </div>

              <aside class="passport-card__rail" aria-label="Ключевая информация">
                <section class="passport-card__rail-box passport-card__rail-box--highlight">
                  <p class="passport-card__rail-kicker">5 штампов</p>
                  <p class="passport-card__rail-strong">Открывают доступ к спецсобытиям фестиваля</p>
                </section>

                <section class="passport-card__rail-box">
                  <p class="passport-card__rail-caption">Период фестиваля</p>
                  <p class="passport-card__rail-value">{festivalPeriod}</p>
                </section>

                <section class="passport-card__rail-box">
                  <p class="passport-card__rail-caption">Официальный сайт фестиваля</p>
                  <a href="https://kgd80.ru" target="_blank" rel="noreferrer" tabindex={accessible ? undefined : -1}>
                    kgd80.ru
                  </a>
                </section>

                <section class="passport-card__rail-box passport-card__rail-box--qr" aria-labelledby={`passport-qr-${key}`}>
                  <div class="passport-card__rail-head">
                    <p class="passport-card__section-label passport-card__section-label--light" id={`passport-qr-${key}`}>Каналы фестиваля</p>
                    <p class="passport-card__rail-caption passport-card__rail-caption--subtle">Сканируйте QR-код и подписывайтесь на анонсы</p>
                  </div>

                  <div class="passport-card__qr-grid">
                    {qrItems.map((item) => (
                      <a
                        class="passport-card__qr"
                        href={item.href}
                        target="_blank"
                        rel="noreferrer"
                        tabindex={accessible ? undefined : -1}
                      >
                        <img src={item.imageSrc} alt={item.imageAlt} width="250" height="250" loading="lazy" decoding="async" />
                        <strong>{item.title}</strong>
                        <span>{item.caption}</span>
                      </a>
                    ))}
                  </div>
                </section>
              </aside>
            </div>
          </article>
        </section>
      ))}
    </section>
  </main>

  <script is:inline>
    const root = document.querySelector('[data-passport-root]');
    const toneButtons = Array.from(document.querySelectorAll('[data-tone-button]'));
    const printButton = document.querySelector('[data-passport-print]');

    const setTone = (tone) => {
      if (!root) {
        return;
      }

      root.setAttribute('data-passport-tone', tone);
      const url = new URL(window.location.href);
      url.searchParams.set('tone', tone);
      window.history.replaceState({}, '', url);
      toneButtons.forEach((button) => {
        const isActive = button instanceof HTMLElement && button.dataset.toneButton === tone;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    toneButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) {
          return;
        }
        setTone(button.dataset.toneButton || 'color');
      });
    });

    if (printButton instanceof HTMLElement) {
      printButton.addEventListener('click', () => {
        window.print();
      });
    }

    const initialTone = new URL(window.location.href).searchParams.get('tone');
    setTone(initialTone === 'mono' ? 'mono' : 'color');
  </script>
</Layout>

<style>
  @page {
    size: A4 landscape;
    margin: 0;
  }

  .passport-print {
    --passport-sheet-bg: rgba(255, 255, 255, 0.72);
    --passport-card-bg:
      radial-gradient(circle at top left, rgba(216, 75, 49, 0.13), transparent 34%),
      linear-gradient(180deg, rgba(252, 248, 241, 0.98), rgba(245, 238, 229, 0.98));
    --passport-rail-bg:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.18), transparent 24%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0, rgba(255, 255, 255, 0.06) 8px, transparent 8px, transparent 18px),
      linear-gradient(180deg, #bf3f28 0%, #8e2a1a 100%);
    --passport-accent: #8e2a1a;
    --passport-accent-soft: rgba(191, 63, 40, 0.12);
    --passport-line: rgba(18, 17, 14, 0.14);
    --passport-line-strong: rgba(18, 17, 14, 0.22);
    --passport-ink: #181612;
    --passport-ink-soft: rgba(24, 22, 18, 0.74);
    --passport-ink-muted: rgba(24, 22, 18, 0.5);
    padding: clamp(1rem, 2vw, 1.8rem);
  }

  .passport-print[data-passport-tone="mono"] {
    --passport-sheet-bg: rgba(255, 255, 255, 0.92);
    --passport-card-bg:
      radial-gradient(circle at top left, rgba(32, 29, 26, 0.09), transparent 34%),
      linear-gradient(180deg, rgba(251, 249, 245, 0.99), rgba(240, 236, 231, 0.99));
    --passport-rail-bg:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.12), transparent 22%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0, rgba(255, 255, 255, 0.05) 8px, transparent 8px, transparent 18px),
      linear-gradient(180deg, #56514b 0%, #23201d 100%);
    --passport-accent: #23201d;
    --passport-accent-soft: rgba(35, 32, 29, 0.12);
    --passport-line: rgba(18, 17, 14, 0.18);
    --passport-line-strong: rgba(18, 17, 14, 0.3);
  }

  .passport-print[data-passport-tone="mono"] .passport-card__hero-mark img {
    filter: grayscale(1) contrast(1.08);
  }

  .passport-print[data-passport-tone="mono"] .passport-card__rail-box a,
  .passport-print[data-passport-tone="mono"] .passport-card__qr img {
    filter: grayscale(1);
  }

  .passport-toolbar {
    width: min(100%, 297mm);
    margin: 0 auto 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--passport-line);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 22px 52px rgba(18, 17, 14, 0.08);
  }

  .passport-toolbar__copy {
    max-width: 36rem;
  }

  .passport-toolbar__copy h1,
  .passport-toolbar__copy p {
    margin: 0;
  }

  .passport-toolbar__copy h1 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .passport-toolbar__copy > p:last-child {
    margin-top: 0.6rem;
    color: var(--passport-ink-soft);
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .passport-toolbar__eyebrow {
    margin: 0;
    color: var(--passport-ink-muted);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .passport-toolbar__actions {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .passport-toolbar__group {
    display: inline-flex;
    gap: 0.4rem;
    padding: 0.3rem;
    border: 1px solid var(--passport-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
  }

  .passport-toolbar__button {
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    color: var(--passport-ink);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.85rem 1rem;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .passport-toolbar__button:hover,
  .passport-toolbar__button:focus-visible {
    border-color: var(--passport-line-strong);
    transform: translateY(-1px);
  }

  .passport-toolbar__button.is-active,
  .passport-toolbar__button--primary {
    background: var(--passport-accent);
    color: #fff;
  }

  .passport-toolbar__button--primary {
    border-color: var(--passport-accent);
  }

  .passport-sheet {
    position: relative;
    width: min(100%, 297mm);
    min-height: 210mm;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(249, 245, 240, 0.74)),
      var(--passport-sheet-bg);
    border-radius: 1.5rem;
    box-shadow: 0 32px 88px rgba(18, 17, 14, 0.13);
    overflow: hidden;
  }

  .passport-sheet__half {
    padding: 5mm;
  }

  .passport-sheet__cutline {
    position: absolute;
    inset-block: 6mm;
    left: 50%;
    width: 0;
    border-left: 1px dashed rgba(24, 22, 18, 0.34);
    transform: translateX(-0.5px);
    pointer-events: none;
  }

  .passport-sheet__cutline span {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    transform: translateX(-50%) rotate(90deg);
    transform-origin: center;
    white-space: nowrap;
    padding: 0 0.3rem;
    color: rgba(24, 22, 18, 0.48);
    background: rgba(255, 255, 255, 0.86);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .passport-card {
    height: calc(210mm - 10mm);
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--passport-card-bg);
    border: 1px solid var(--passport-line-strong);
    border-radius: 1.15rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
    overflow: hidden;
  }

  .passport-card__header {
    display: grid;
    gap: 0.62rem;
    padding: 0.72rem 0.82rem 0.7rem;
    border-bottom: 1px solid var(--passport-line);
  }

  .passport-card__intro-head {
    display: grid;
    gap: 0.12rem;
  }

  .passport-card__eyebrow,
  .passport-card__label,
  .passport-card__section-label,
  .passport-card__rail-kicker,
  .passport-card__rail-caption,
  .passport-card__field-note,
  .passport-card__stamps-note,
  .stamp-slot__label,
  .stamp-slot__date {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .passport-card__eyebrow,
  .passport-card__field-note,
  .passport-card__stamps-note,
  .passport-card__rail-caption {
    margin: 0;
    color: var(--passport-ink-muted);
    font-size: 0.58rem;
  }

  .passport-card__kicker {
    margin: 0;
    color: var(--passport-accent);
    font-size: 0.76rem;
  }

  .passport-card__brand-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(4.5rem, 5rem);
    gap: 0.72rem;
    align-items: start;
  }

  .passport-card__title-block {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }

  .passport-card__label,
  .passport-card__section-label {
    margin: 0;
    color: var(--passport-accent);
    font-size: 0.62rem;
  }

  .passport-card__title {
    margin: 0;
    color: var(--passport-ink);
    font-family: var(--font-display);
    font-size: clamp(1.14rem, 0.94rem + 0.58vw, 1.48rem);
    line-height: 0.94;
    text-transform: uppercase;
  }

  .passport-card__hero-mark {
    display: grid;
    place-items: start end;
    align-self: start;
  }

  .passport-card__hero-mark img {
    width: 100%;
    max-width: 4.95rem;
    height: auto;
  }

  .passport-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(5.15rem, 0.95fr);
    min-height: 0;
  }

  .passport-card__main {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 0.72rem 0.82rem 0.82rem;
  }

  .passport-card__summary,
  .passport-card__identity {
    padding: 0.62rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.95rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.72)),
      var(--passport-accent-soft);
  }

  .passport-card__summary p,
  .passport-card__rail-box p,
  .passport-card__rail-box a,
  .passport-card__stamps-head p,
  .passport-card__field-head p {
    margin: 0;
  }

  .passport-card__summary {
    display: grid;
    gap: 0.35rem;
  }

  .passport-card__summary p {
    color: var(--passport-ink-soft);
    font-size: 0.7rem;
    line-height: 1.34;
  }

  .passport-card__field-head {
    display: grid;
    gap: 0.12rem;
  }

  .passport-card__field-line {
    min-height: 0.9rem;
    margin-top: 0.38rem;
    border-bottom: 1.5px solid var(--passport-line-strong);
  }

  .passport-card__stamps {
    display: grid;
    gap: 0.45rem;
  }

  .passport-card__stamps-head {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    align-items: baseline;
  }

  .passport-card__stamps-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.42rem;
  }

  .stamp-slot {
    display: grid;
    gap: 0.26rem;
    padding: 0.42rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.72);
  }

  .stamp-slot__top {
    display: flex;
    justify-content: space-between;
    gap: 0.45rem;
    align-items: baseline;
  }

  .stamp-slot__number {
    color: var(--passport-accent);
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1;
  }

  .stamp-slot__label {
    color: var(--passport-ink-muted);
    font-size: 0.5rem;
    text-align: right;
  }

  .stamp-slot__seal {
    min-height: 1.45rem;
    display: grid;
    place-items: center;
    border: 1px dashed var(--passport-line-strong);
    border-radius: 0.7rem;
    color: var(--passport-ink-muted);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stamp-slot__date {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--passport-ink-soft);
    font-size: 0.5rem;
  }

  .stamp-slot__date-line {
    flex: 1 1 auto;
    min-height: 0.62rem;
    border-bottom: 1px solid var(--passport-line-strong);
  }

  .passport-card__rail {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 0.72rem 0.74rem 0.78rem;
    background: var(--passport-rail-bg);
    color: #fff;
  }

  .passport-card__rail-box {
    display: grid;
    gap: 0.28rem;
    padding: 0.56rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
  }

  .passport-card__rail-box--highlight {
    gap: 0.36rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.09)),
      rgba(255, 255, 255, 0.08);
  }

  .passport-card__rail-box--qr {
    gap: 0.45rem;
  }

  .passport-card__section-label--light,
  .passport-card__rail-caption,
  .passport-card__rail-caption--subtle {
    color: rgba(255, 255, 255, 0.78);
  }

  .passport-card__rail-kicker {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.56rem;
  }

  .passport-card__rail-strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .passport-card__rail-value {
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .passport-card__rail-box a {
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12rem;
  }

  .passport-card__rail-head {
    display: grid;
    gap: 0.22rem;
  }

  .passport-card__qr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.34rem;
  }

  .passport-card__qr {
    display: grid;
