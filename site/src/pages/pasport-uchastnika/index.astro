---
import Layout from '../../../src/layouts/Layout.astro';

const routeTitle = 'Паспорт участника фестиваля | 80 историй о главном';
const routeDescription = 'Печатный макет A4 с двумя A5-экземплярами паспорта участника фестиваля «80 историй о главном».';
const festivalPeriod = '28 марта - 19 июля 2026';
const stampSlots = Array.from({ length: 12 }, (_, index) => ({
  index: index + 1,
}));
const qrItems = [
  {
    title: 'Telegram',
    caption: '@kenigevents',
    href: 'https://t.me/kenigevents',
    imageSrc: '/generated/telegram/kenigevents-qr.svg',
    imageAlt: 'QR-код Telegram для оперативной информации по фестивалю',
  },
  {
    title: 'MAX',
    caption: 'max.ru',
    href: 'https://max.ru/join/do_4eLW85-yK_dXcc6f2cmKp9utJuFl_hCo0cxnJ1QA',
    imageSrc: '/generated/max/max-channel-qr.svg',
    imageAlt: 'QR-код MAX для оперативной информации по фестивалю',
  },
];
const copies = [
  { key: 'left', accessible: true },
  { key: 'right', accessible: false },
];
---

<Layout
  title={routeTitle}
  description={routeDescription}
  canonicalPath="/pasport-uchastnika/"
  robots="noindex, nofollow"
>
  <main class="passport-print" data-passport-root data-passport-tone="color">
    <section class="passport-toolbar screen-only" aria-label="Управление макетом">
      <div class="passport-toolbar__copy">
        <p class="passport-toolbar__eyebrow">Печатный макет фестиваля</p>
        <h1>Паспорт участника для A4 и A5</h1>
        <p>
          На печать выводится лист A4 в альбомной ориентации. На нём уже собраны две одинаковые A5-копии
          с безопасными полями и линией реза.
        </p>
      </div>

      <div class="passport-toolbar__actions">
        <div class="passport-toolbar__group" role="group" aria-label="Режим предпросмотра">
          <button class="passport-toolbar__button is-active" type="button" data-tone-button="color">Цветной preview</button>
          <button class="passport-toolbar__button" type="button" data-tone-button="mono">Ч/б preview</button>
        </div>
        <a class="passport-toolbar__button passport-toolbar__button--primary" href="/pasport-uchastnika/passport-a4.pdf" download>
          Скачать PDF
        </a>
        <button class="passport-toolbar__button" type="button" data-passport-print>
          Печать из браузера
        </button>
      </div>
    </section>

    <section class="passport-sheet" aria-label="Лист A4 с двумя копиями паспорта участника">
      <div class="passport-sheet__cutline" aria-hidden="true">
        <span>Линия реза</span>
      </div>

      {copies.map(({ key, accessible }) => (
        <section class={`passport-sheet__half passport-sheet__half--${key}`}>
          <article class="passport-card" aria-hidden={accessible ? undefined : 'true'}>
            <header class="passport-card__header">
              <div class="passport-card__header-copy">
                <p class="passport-card__eyebrow">Просветительский фестиваль Российского общества Знание</p>
                <h2 class="passport-card__document-title" id={`passport-title-${key}`}>Паспорт участника фестиваля</h2>
                <p class="passport-card__festival-name">80 историй о главном</p>
              </div>

              <div class="passport-card__hero-mark">
                <img
                  src="/shared-assets/logo-80-istorii-hero.svg"
                  alt="Логотип фестиваля 80 историй о главном"
                  width="431"
                  height="373"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </header>

            <div class="passport-card__meta">
              <span>{festivalPeriod}</span>
              <a href="https://kgd80.ru" target="_blank" rel="noreferrer" tabindex={accessible ? undefined : -1}>
                kgd80.ru
              </a>
            </div>

            <section class="passport-card__cta" aria-label="Условия участия">
              <p class="passport-card__cta-lead">Посетите не менее 5 событий фестиваля</p>
              <p class="passport-card__cta-text">
                лекций или открытых дискуссий, чтобы получить возможность посетить спецпроекты фестиваля
                или дополнительные места на события, на которые закончились места.
              </p>
            </section>

            <section class="passport-card__identity" aria-labelledby={`passport-name-${key}`}>
              <div class="passport-card__identity-head">
                <p class="passport-card__section-label" id={`passport-name-${key}`}>Участник</p>
                <p class="passport-card__field-note">Фамилия, имя, отчество</p>
              </div>
              <div class="passport-card__field-line" aria-hidden="true"></div>
            </section>

            <section class="passport-card__stamp-note" aria-label="Правило проставления штампов">
              <p>Штампы ставятся за посещение лекций и открытых дискуссий.</p>
            </section>

            <section class="passport-card__stamps" aria-labelledby={`passport-stamps-${key}`}>
              <div class="passport-card__stamps-head">
                <div>
                  <p class="passport-card__section-label" id={`passport-stamps-${key}`}>Зоны для штампов</p>
                  <p class="passport-card__stamps-note">12 круговых отметок с полем даты</p>
                </div>
              </div>

              <div class="passport-card__stamps-grid">
                {stampSlots.map((slot) => (
                  <article class="stamp-slot" aria-label={`Зона штампа ${slot.index}`}>
                    <div class="stamp-slot__badge">{String(slot.index).padStart(2, '0')}</div>
                    <div class="stamp-slot__seal" aria-hidden="true"></div>
                    <div class="stamp-slot__date">
                      <span>Дата</span>
                      <span class="stamp-slot__date-line" aria-hidden="true"></span>
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <section class="passport-card__info" aria-labelledby={`passport-info-${key}`}>
              <div class="passport-card__info-copy">
                <p class="passport-card__section-label" id={`passport-info-${key}`}>Оперативная информация по фестивалю</p>
                <p class="passport-card__info-cta">Подпишитесь</p>
                <p class="passport-card__info-note">База анонсов событий Калининградской области</p>
              </div>

              <div class="passport-card__qr-grid">
                {qrItems.map((item) => (
                  <a
                    class="passport-card__qr"
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                    tabindex={accessible ? undefined : -1}
                    aria-label={`${item.title}: ${item.caption}`}
                  >
                    <img src={item.imageSrc} alt={item.imageAlt} width="250" height="250" loading="lazy" decoding="async" />
                    <strong>{item.title}</strong>
                    <span>{item.caption}</span>
                  </a>
                ))}
              </div>
            </section>
          </article>
        </section>
      ))}
    </section>
  </main>

  <script is:inline>
    const root = document.querySelector('[data-passport-root]');
    const toneButtons = Array.from(document.querySelectorAll('[data-tone-button]'));
    const printButton = document.querySelector('[data-passport-print]');

    const setTone = (tone) => {
      if (!root) {
        return;
      }

      root.setAttribute('data-passport-tone', tone);
      const url = new URL(window.location.href);
      url.searchParams.set('tone', tone);
      window.history.replaceState({}, '', url);
      toneButtons.forEach((button) => {
        const isActive = button instanceof HTMLElement && button.dataset.toneButton === tone;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    toneButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) {
          return;
        }
        setTone(button.dataset.toneButton || 'color');
      });
    });

    if (printButton instanceof HTMLElement) {
      printButton.addEventListener('click', () => {
        window.print();
      });
    }

    const initialTone = new URL(window.location.href).searchParams.get('tone');
    setTone(initialTone === 'mono' ? 'mono' : 'color');
  </script>
</Layout>

<style>
  @page {
    size: A4 landscape;
    margin: 0;
  }

  .passport-print {
    --passport-sheet-bg: rgba(255, 255, 255, 0.7);
    --passport-card-bg:
      radial-gradient(circle at top left, rgba(199, 83, 50, 0.14), transparent 34%),
      linear-gradient(180deg, rgba(252, 248, 242, 0.98), rgba(244, 237, 228, 0.98));
    --passport-card-shadow: 0 32px 70px rgba(77, 42, 21, 0.14);
    --passport-accent: #973823;
    --passport-accent-deep: #6d1f14;
    --passport-accent-soft: rgba(151, 56, 35, 0.12);
    --passport-line: rgba(26, 22, 18, 0.14);
    --passport-line-strong: rgba(26, 22, 18, 0.24);
    --passport-ink: #1c1815;
    --passport-ink-soft: rgba(28, 24, 21, 0.76);
    --passport-ink-muted: rgba(28, 24, 21, 0.52);
    --passport-page-bg:
      radial-gradient(circle at top center, rgba(255, 255, 255, 0.94), transparent 46%),
      linear-gradient(180deg, #f6efe7 0%, #efe5da 100%);
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.8rem);
    background: var(--passport-page-bg);
  }

  .passport-print[data-passport-tone="mono"] {
    --passport-sheet-bg: rgba(255, 255, 255, 0.9);
    --passport-card-bg:
      radial-gradient(circle at top left, rgba(40, 35, 31, 0.08), transparent 34%),
      linear-gradient(180deg, rgba(252, 250, 247, 0.99), rgba(239, 235, 230, 0.99));
    --passport-card-shadow: 0 24px 52px rgba(44, 40, 36, 0.12);
    --passport-accent: #2f2a26;
    --passport-accent-deep: #1e1b18;
    --passport-accent-soft: rgba(47, 42, 38, 0.12);
    --passport-line: rgba(24, 21, 18, 0.14);
    --passport-line-strong: rgba(24, 21, 18, 0.24);
    --passport-page-bg:
      radial-gradient(circle at top center, rgba(255, 255, 255, 0.92), transparent 48%),
      linear-gradient(180deg, #f2f0ed 0%, #e4e0db 100%);
  }

  .passport-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    max-width: 297mm;
    margin: 0 auto 1rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 18px 48px rgba(72, 46, 30, 0.1);
    backdrop-filter: blur(16px);
  }

  .passport-toolbar__copy {
    max-width: 38rem;
  }

  .passport-toolbar__eyebrow {
    margin: 0 0 0.2rem;
    color: var(--passport-ink-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-toolbar h1 {
    margin: 0;
    color: var(--passport-ink);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 0.96;
    text-transform: uppercase;
  }

  .passport-toolbar__copy p:last-child {
    margin: 0.55rem 0 0;
    max-width: 34rem;
    color: var(--passport-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .passport-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .passport-toolbar__group {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.28rem;
    border-radius: 999px;
    background: rgba(28, 24, 21, 0.08);
  }

  .passport-toolbar__button {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.75rem 1.05rem;
    background: rgba(255, 255, 255, 0.96);
    color: var(--passport-ink);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .passport-toolbar__button:hover,
  .passport-toolbar__button:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(28, 24, 21, 0.14);
  }

  .passport-toolbar__button.is-active,
  .passport-toolbar__button--primary {
    background: var(--passport-accent-deep);
    color: #fff;
  }

  .passport-sheet {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem;
    width: min(100%, 297mm);
    min-height: 210mm;
    margin: 0 auto;
    padding: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.4rem;
    background: var(--passport-sheet-bg);
    box-shadow: 0 30px 80px rgba(78, 50, 31, 0.12);
    backdrop-filter: blur(16px);
  }

  .passport-sheet__cutline {
    position: absolute;
    inset: 1rem auto 1rem 50%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 0;
    border-left: 1px dashed rgba(28, 24, 21, 0.28);
    pointer-events: none;
  }

  .passport-sheet__cutline span {
    margin-top: 0.15rem;
    padding: 0.2rem 0.45rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--passport-ink-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .passport-sheet__half {
    display: flex;
    min-height: calc(210mm - 1.8rem);
  }

  .passport-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    padding: 0.95rem;
    border: 1px solid var(--passport-line-strong);
    border-radius: 1.05rem;
    background: var(--passport-card-bg);
    box-shadow: var(--passport-card-shadow);
    overflow: hidden;
  }

  .passport-card__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: start;
  }

  .passport-card__eyebrow {
    margin: 0 0 0.2rem;
    color: var(--passport-ink-muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-card__document-title {
    margin: 0;
    color: var(--passport-ink);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 0.94;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .passport-card__festival-name {
    margin: 0.2rem 0 0;
    color: var(--passport-accent);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.08;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .passport-card__hero-mark {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: clamp(3.5rem, 18%, 4.6rem);
  }

  .passport-card__hero-mark img {
    display: block;
    width: 100%;
    height: auto;
  }

  .passport-print[data-passport-tone="mono"] .passport-card__hero-mark img {
    filter: grayscale(1);
  }

  .passport-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--passport-ink-soft);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .passport-card__meta a {
    color: var(--passport-accent-deep);
    text-decoration: none;
  }

  .passport-card__cta {
    padding: 0.8rem 0.9rem;
    border-radius: 0.95rem;
    background:
      linear-gradient(180deg, rgba(151, 56, 35, 0.94), rgba(109, 31, 20, 0.98));
    color: #fff;
  }

  .passport-print[data-passport-tone="mono"] .passport-card__cta {
    background: linear-gradient(180deg, rgba(47, 42, 38, 0.95), rgba(30, 27, 24, 0.98));
  }

  .passport-card__cta-lead {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .passport-card__cta-text {
    margin: 0.42rem 0 0;
    font-size: 0.7rem;
    line-height: 1.34;
    color: rgba(255, 255, 255, 0.84);
  }

  .passport-card__identity,
  .passport-card__stamp-note {
    padding: 0.65rem 0.72rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.92rem;
    background: rgba(255, 255, 255, 0.76);
  }

  .passport-card__identity-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .passport-card__section-label {
    margin: 0;
    color: var(--passport-ink-muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-card__field-note,
  .passport-card__stamp-note p,
  .passport-card__stamps-note,
  .passport-card__info-note {
    margin: 0;
    color: var(--passport-ink-soft);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .passport-card__field-line {
    margin-top: 0.42rem;
    border-bottom: 1px solid var(--passport-line-strong);
    min-height: 0.9rem;
  }

  .passport-card__stamps {
    padding: 0.72rem;
    border: 1px solid var(--passport-line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.8);
  }

  .passport-card__stamps-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .passport-card__stamps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.42rem;
  }

  .stamp-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.26rem;
    min-height: 4.45rem;
    padding: 0.42rem 0.28rem 0.36rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.82rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(247, 241, 234, 0.96));
  }

  .passport-print[data-passport-tone="mono"] .stamp-slot {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(240, 235, 230, 0.96));
  }

  .stamp-slot__badge {
    align-self: flex-start;
    color: var(--passport-ink-muted);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .stamp-slot__seal {
    width: 2.45rem;
    height: 2.45rem;
    border: 1.4px dashed var(--passport-accent);
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.82) 0, rgba(255, 255, 255, 0.82) 62%, transparent 63%);
  }

  .passport-print[data-passport-tone="mono"] .stamp-slot__seal {
    border-color: var(--passport-accent-deep);
  }

  .stamp-slot__date {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 0.22rem;
    color: var(--passport-ink-muted);
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .stamp-slot__date-line {
    flex: 1;
    min-width: 1.1rem;
    border-bottom: 1px solid var(--passport-line-strong);
  }

  .passport-card__info {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
    margin-top: auto;
    padding: 0.78rem;
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(28, 24, 21, 0.06), rgba(28, 24, 21, 0.08)),
      rgba(255, 255, 255, 0.84);
    border: 1px solid var(--passport-line);
  }

  .passport-card__info-cta {
    margin: 0.18rem 0 0;
    color: var(--passport-accent);
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .passport-card__qr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .passport-card__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    padding: 0.68rem 0.5rem;
    border: 1px solid var(--passport-line-strong);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.94);
    color: var(--passport-ink);
    text-align: center;
    text-decoration: none;
  }

  .passport-card__qr img {
    display: block;
    width: min(100%, 4.6rem);
    height: auto;
  }

  .passport-card__qr strong {
    font-size: 0.78rem;
    line-height: 1;
  }

  .passport-card__qr span {
    color: var(--passport-ink-soft);
    font-size: 0.64rem;
    line-height: 1.2;
  }

  @media (max-width: 1080px) {
    .passport-toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .passport-toolbar__actions {
      justify-content: flex-start;
    }

    .passport-sheet {
      grid-template-columns: 1fr;
      width: min(100%, 28rem);
      min-height: auto;
    }

    .passport-sheet__cutline {
      display: none;
    }

    .passport-sheet__half {
      min-height: auto;
    }
  }

  @media (max-width: 720px) {
    .passport-print {
      padding: 0.8rem;
    }

    .passport-toolbar {
      padding: 1rem;
    }

    .passport-toolbar h1 {
      font-size: 1.7rem;
